const QUESTION_BANK_DATA = {"meta":{"title":"Trade Finance Quiz Lab","version":"1.0.0","source":"Deutsche Bank, A Guide to Trade Finance, 2nd ed. (2025) + Bản tóm tắt mở rộng tiếng Việt (2026)","categories":[{"id":"foundation","label":"01 · Nền tảng giao dịch","description":"Hợp đồng, chứng từ, dòng hàng, rủi ro"},{"id":"settlement","label":"02 · Phương thức thanh toán","description":"Open Account, Advance, D/P, D/A"},{"id":"lc","label":"03A · Commercial L/C","description":"Phát hành, chứng từ, các loại L/C"},{"id":"sblc","label":"03B · Standby L/C","description":"8 loại standby và yêu cầu thanh toán"},{"id":"guarantee","label":"04 · Letter of Guarantee","description":"Demand Guarantee, direct/indirect"},{"id":"scf","label":"05 · Supply Chain Finance","description":"10 kỹ thuật, factoring, forfaiting"},{"id":"funding","label":"06 · Tài trợ sản xuất/hàng hóa","description":"Pre-shipment, BBF, RBL, PXF, PPF"},{"id":"risk","label":"07 · Chuyển dịch rủi ro","description":"Funded, Unfunded, RPA"},{"id":"insurance","label":"08 · Bảo hiểm & ECA","description":"Credit Insurance, Cargo Insurance"},{"id":"fx","label":"09 · Payments & FX","description":"Spot, Forward, Swap, Option, Bid/Ask"},{"id":"cases","label":"10 · Case thực tế","description":"Chọn công cụ theo tình huống"},{"id":"rules","label":"11 · Rules & Compliance","description":"ICC rules, AML, chứng từ, số hóa"},{"id":"decision","label":"12 · SWOT & lựa chọn","description":"Lợi ích, hạn chế và kết hợp sản phẩm"}],"total":213},"questions":[{"id":"TF001","category":"foundation","question":"Trade Finance hỗ trợ doanh nghiệp chủ yếu ở những khía cạnh nào?","options":["Tài trợ vốn, thanh toán, quản trị rủi ro trong giao dịch thương mại","Chỉ chuyển ngoại tệ","Chỉ tài trợ vốn cố định","Chỉ mua bảo hiểm vận tải"],"correct":0,"explanation":"Trade Finance hỗ trợ financing, monetisation, risk mitigation và settlement của dòng thương mại.","source":"DB tr.12","level":"Cơ bản"},{"id":"TF002","category":"foundation","question":"Trong giao dịch thương mại, Sales Contract có vai trò gì?","options":["Xác lập quyền, nghĩa vụ mua bán và điều kiện giao hàng/thanh toán","Là cam kết thanh toán của ngân hàng","Thay thế hoàn toàn vận đơn","Là hợp đồng giữa hai ngân hàng"],"correct":0,"explanation":"Hợp đồng thương mại là cơ sở giao dịch; L/C hoặc bảo lãnh nếu có là cam kết riêng.","source":"DB tr.16","level":"Cơ bản"},{"id":"TF003","category":"foundation","question":"Commercial Invoice được dùng để làm gì?","options":["Thể hiện giao dịch hàng hóa, giá trị và số tiền theo hóa đơn","Xác nhận hàng đã lên tàu trong mọi trường hợp","Cam kết bảo lãnh ngân hàng","Bắt buộc là bằng chứng chuyển quyền sở hữu hàng"],"correct":0,"explanation":"Invoice ghi thông tin thương mại và số tiền; chức năng của B/L, C/O hay bảo hiểm là khác nhau.","source":"DB tr.24–31","level":"Cơ bản"},{"id":"TF004","category":"foundation","question":"Vai trò thường gặp của negotiable Bill of Lading là gì?","options":["Biên nhận hàng, bằng chứng hợp đồng vận chuyển và có thể là chứng từ sở hữu","Cam kết Buyer chắc chắn trả tiền","Chứng nhận xuất xứ duy nhất","Giấy bảo hiểm trách nhiệm Buyer"],"correct":0,"explanation":"B/L có các chức năng phụ thuộc loại vận đơn; không phải mọi vận đơn đều là document of title.","source":"Ứng dụng từ DB tr.87–88","level":"Cơ bản"},{"id":"TF005","category":"foundation","question":"Sự khác nhau cơ bản giữa Issue Date và On-board Date của B/L là gì?","options":["Issue Date là ngày phát hành; On-board Date là ngày xác nhận hàng xếp lên tàu","Hai ngày luôn phải trùng nhau","Issue Date luôn là ngày Buyer nhận hàng","On-board Date luôn là ngày Seller nhận tiền"],"correct":0,"explanation":"Hai ngày có thể khác nhau; cách xác định shipment date theo UCP 600 còn phụ thuộc ghi chú trên vận đơn.","source":"Ứng dụng chứng từ; DB tr.26–31","level":"Trung bình"},{"id":"TF006","category":"foundation","question":"Khi hàng hỏng trong quá trình vận chuyển, điều gì quyết định ai chịu rủi ro giữa Buyer và Seller?","options":["Hợp đồng, điều kiện Incoterms được dẫn chiếu và sự kiện chuyển rủi ro","Luôn là Seller","Luôn là Buyer","Ngân hàng phát hành L/C luôn bồi thường"],"correct":0,"explanation":"Rủi ro hư hỏng hàng hóa không tự động thuộc ngân hàng, và có thể cần cargo insurance.","source":"Ứng dụng; DB tr.14–15","level":"Trung bình"},{"id":"TF007","category":"foundation","question":"KYC trong Trade Finance giúp ngân hàng chủ yếu làm gì?","options":["Nhận biết khách hàng, mục đích giao dịch, nguồn tiền và tuân thủ","Bảo đảm hàng hóa đạt chất lượng","Thay Seller kiểm tra toàn bộ nhà máy","Tự động bảo hiểm lô hàng"],"correct":0,"explanation":"KYC là nền tảng đánh giá, giám sát và kiểm soát tuân thủ đối tác/giao dịch.","source":"DB tr.15; 93–99","level":"Trung bình"},{"id":"TF008","category":"foundation","question":"SWIFT được hiểu đúng nhất là gì?","options":["Mạng truyền thông điệp tài chính an toàn, chuẩn hóa giữa các tổ chức","Ngân hàng trung ương toàn cầu","Công ty bảo hiểm tín dụng","Tổ chức sở hữu tất cả vận đơn"],"correct":0,"explanation":"SWIFT cung cấp hạ tầng trao đổi thông điệp, không tự bảo đảm tiền hàng.","source":"DB tr.19–20","level":"Trung bình"},{"id":"TF009","category":"foundation","question":"Thế nào là Credit Risk trong giao dịch thương mại?","options":["Khả năng đối tác không thực hiện nghĩa vụ thanh toán","Chỉ rủi ro giá hàng tăng","Chỉ rủi ro tàu đi muộn","Rủi ro do chênh lệch phí logistics"],"correct":0,"explanation":"Credit Risk thể hiện nguy cơ không trả tiền hoặc vỡ nợ.","source":"DB tr.14–15","level":"Trung bình"},{"id":"TF010","category":"foundation","question":"Phát biểu nào đúng về ngân hàng trong giao dịch có L/C?","options":["Ngân hàng xử lý chứng từ theo cam kết, không tự bảo đảm chất lượng hàng hóa","Ngân hàng kiểm định thực tế mọi container","Ngân hàng luôn đại diện pháp lý cho Seller","Ngân hàng có nghĩa vụ bảo hiểm hàng"],"correct":0,"explanation":"Nguyên tắc ngân hàng giao dịch trên cơ sở chứng từ, không phải hàng hóa.","source":"DB tr.28","level":"Trung bình"},{"id":"TF011","category":"foundation","question":"Thế nào là Currency Risk?","options":["Rủi ro thay đổi tỷ giá gây lỗ hoặc ảnh hưởng dòng tiền","Buyer không ký hợp đồng","Hàng không đủ số kiện","Sản phẩm không đạt chỉ tiêu ESG"],"correct":0,"explanation":"Rủi ro FX xuất hiện khi đồng tiền nghĩa vụ và đồng tiền chi tiêu/ghi sổ khác nhau.","source":"DB tr.79–80","level":"Trung bình"},{"id":"TF012","category":"foundation","question":"Trade Finance chỉ dành cho giao dịch xuyên biên giới?","options":["Không; nhiều công cụ cũng áp dụng trong thương mại nội địa theo quy định","Đúng, mọi L/C nội địa đều bị cấm","Đúng, factoring chỉ dành cho xuất khẩu","Đúng, bảo lãnh nội địa không tồn tại"],"correct":0,"explanation":"Deutsche Bank tập trung quốc tế, nhưng nhiều công cụ có cả ứng dụng nội địa; xem quy định địa phương.","source":"Ứng dụng mở rộng; DB tr.32","level":"Trung bình"},{"id":"TF013","category":"settlement","question":"Open Account nghĩa là gì?","options":["Seller giao hàng/chứng từ theo thỏa thuận trước, Buyer thanh toán sau","Buyer luôn thanh toán trước 100%","Ngân hàng phát hành L/C","Chỉ nhận hàng khi xuất trình bảo lãnh"],"correct":0,"explanation":"Open Account dựa nhiều vào tín nhiệm Buyer, thường có kỳ hạn 30/60/90 ngày.","source":"DB tr.22","level":"Cơ bản"},{"id":"TF014","category":"settlement","question":"Open Account “Net 60 days from Invoice Date” bắt đầu tính từ ngày nào?","options":["Ngày hóa đơn theo điều khoản hợp đồng","Ngày hàng cập cảng mặc định","Ngày ngân hàng mở L/C","Ngày Buyer trả tiền lần đầu"],"correct":0,"explanation":"Mốc tính phải đọc chính xác Payment Terms; ở đây là Invoice Date.","source":"Ứng dụng Open Account; DB tr.22","level":"Cơ bản"},{"id":"TF015","category":"settlement","question":"Rủi ro lớn nhất của Seller trong Open Account không bảo đảm là gì?","options":["Buyer chậm hoặc không thanh toán sau khi nhận hàng","Buyer mất cơ hội ứng tiền","Ngân hàng không đủ tiền thu phí","Không được phát hành Invoice"],"correct":0,"explanation":"Seller có thể sử dụng credit insurance/SCF để giảm rủi ro và tăng thanh khoản.","source":"DB tr.22","level":"Cơ bản"},{"id":"TF016","category":"settlement","question":"Advance Payment là gì?","options":["Buyer trả một phần/toàn bộ tiền trước khi Seller giao hàng","Seller giao hàng trước rồi Buyer trả sau","Ngân hàng trả trước cho Buyer vô điều kiện","Buyer chấp nhận hối phiếu rồi nhận chứng từ"],"correct":0,"explanation":"Advance Payment chuyển nhiều rủi ro không giao hàng về phía Buyer.","source":"DB tr.23","level":"Cơ bản"},{"id":"TF017","category":"settlement","question":"Công cụ nào giúp Buyer bảo vệ tiền ứng trước cho Seller?","options":["Advance Payment Guarantee (APG)","Commercial Invoice","Packing List","FX Spot"],"correct":0,"explanation":"APG hỗ trợ hoàn trả tiền ứng trước theo điều kiện bảo lãnh nếu Seller không thực hiện nghĩa vụ được bảo đảm.","source":"DB tr.23; 34","level":"Trung bình"},{"id":"TF018","category":"settlement","question":"D/P viết đầy đủ là gì?","options":["Documents against Payment","Documents after Production","Delivery against Performance","Draft against Pricing"],"correct":0,"explanation":"D/P là nhờ thu trả tiền đổi chứng từ.","source":"DB tr.24","level":"Trung bình"},{"id":"TF019","category":"settlement","question":"Trong D/P at Sight, ngân hàng được giao bộ chứng từ cho Buyer khi nào?","options":["Khi Buyer đã thanh toán theo chỉ thị nhờ thu","Ngay sau khi ký hợp đồng","Ngay khi hàng rời cảng","Sau khi Buyer chỉ ký chấp nhận hối phiếu kỳ hạn"],"correct":0,"explanation":"D/P trao chứng từ khi thanh toán, khác D/A trao khi chấp nhận.","source":"DB tr.24–25","level":"Trung bình"},{"id":"TF020","category":"settlement","question":"D/A viết đầy đủ là gì?","options":["Documents against Acceptance","Documents against Advance","Deposit after Acceptance","Delivery after Advance"],"correct":0,"explanation":"D/A là nhờ thu chấp nhận thanh toán kỳ hạn.","source":"DB tr.24","level":"Trung bình"},{"id":"TF021","category":"settlement","question":"Trong D/A, sự kiện cho phép giao chứng từ thông thường là gì?","options":["Buyer chấp nhận hối phiếu/nghĩa vụ thanh toán kỳ hạn","Buyer trả tiền ngay lập tức trong mọi trường hợp","Seller hoàn tất KYC","Ngân hàng xác nhận chất lượng hàng"],"correct":0,"explanation":"D/A cho Buyer nhận chứng từ để nhận hàng và thanh toán lúc đáo hạn.","source":"DB tr.24–25","level":"Trung bình"},{"id":"TF022","category":"settlement","question":"D/A 60 days after sight thường tính kỳ hạn từ sự kiện nào?","options":["Ngày xuất trình/chấp nhận theo cấu trúc hối phiếu và điều khoản giao dịch","Ngày Seller bắt đầu tìm nguyên liệu","Ngày ngân hàng tài trợ phát hành bảo hiểm","Ngày Buyer bán hết hàng"],"correct":0,"explanation":"“After sight” cần xác định ngày sight/acceptance theo chứng từ và quy tắc áp dụng.","source":"Ứng dụng D/A; DB tr.24–25","level":"Trung bình"},{"id":"TF023","category":"settlement","question":"Trong D/P, Collecting Bank có nghĩa vụ trả tiền thay Buyer?","options":["Không, ngân hàng chủ yếu thực hiện chỉ thị nhờ thu","Có, bắt buộc trả 100%","Có, nếu Buyer đã ký hợp đồng bán hàng","Có, chỉ vì ngân hàng đang giữ vận đơn"],"correct":0,"explanation":"Nhờ thu khác L/C: ngân hàng thu hộ, không mặc định có undertaking trả thay.","source":"DB tr.24–26","level":"Trung bình"},{"id":"TF024","category":"settlement","question":"D/P bảo vệ việc kiểm soát hàng hóa tuyệt đối?","options":["Không; hiệu quả phụ thuộc loại chứng từ vận tải và cơ chế giải phóng hàng","Có, với mọi sea waybill","Có, vì ngân hàng giữ container","Có, dù hàng đã được giao không cần B/L gốc"],"correct":0,"explanation":"D/P kiểm soát bộ chứng từ; quyền nhận hàng thực tế cần xem B/L/sea waybill và luật vận tải.","source":"Ứng dụng chứng từ; DB tr.24–26","level":"Trung bình"},{"id":"TF025","category":"settlement","question":"Buyer đã nhận chứng từ theo D/A nhưng không trả tiền lúc đáo hạn: rủi ro chính ở đâu?","options":["Seller đối mặt rủi ro tín dụng Buyer","Ngân hàng thu hộ tự động trả thay","Hãng tàu bắt buộc bồi thường toàn bộ tiền hàng","Không bên nào chịu tổn thất"],"correct":0,"explanation":"Buyer acceptance không phải bank guarantee.","source":"DB tr.24–26","level":"Trung bình"},{"id":"TF026","category":"settlement","question":"Thang rủi ro thanh toán của Deutsche Bank: phương thức nào rủi ro cao nhất cho Seller?","options":["Open Account","Advance Payment","Confirmed L/C đủ điều kiện","Payment in Advance 100%"],"correct":0,"explanation":"Seller giao trước, chưa có cam kết ngân hàng trả thay, nên rủi ro Seller cao.","source":"DB tr.21, Figure 4","level":"Trung bình"},{"id":"TF027","category":"settlement","question":"Phương thức nào thường có rủi ro thanh toán cao nhất cho Buyer?","options":["Advance Payment","Open Account","D/A","Confirmed L/C"],"correct":0,"explanation":"Buyer trả tiền trước khi nhận hàng, chịu rủi ro Seller không thực hiện.","source":"DB tr.21, Figure 4","level":"Trung bình"},{"id":"TF028","category":"settlement","question":"Vai trò Remitting Bank trong Documentary Collection là gì?","options":["Nhận chỉ thị và chứng từ từ Seller, chuyển đi nhờ thu","Là hãng tàu phát hành vận đơn","Là người mua ký hối phiếu","Là tổ chức bảo hiểm hàng"],"correct":0,"explanation":"Remitting Bank là ngân hàng được Principal giao xử lý việc nhờ thu.","source":"DB tr.25","level":"Trung bình"},{"id":"TF029","category":"settlement","question":"Vai trò Presenting Bank trong Documentary Collection là gì?","options":["Xuất trình chứng từ cho Buyer để yêu cầu thanh toán/chấp nhận","Luôn phát hành L/C","Luôn mua lại khoản phải thu","Chứng nhận xuất xứ hàng hóa"],"correct":0,"explanation":"Presenting Bank thường là collecting bank trực tiếp tiếp xúc drawee.","source":"DB tr.25","level":"Trung bình"},{"id":"TF030","category":"settlement","question":"D/P phù hợp hơn khi nào?","options":["Có mức độ tín nhiệm nhất định và muốn kiểm soát chứng từ với chi phí thấp hơn L/C","Buyer rất rủi ro, Seller không muốn chịu rủi ro nào","Hàng đã mất hoàn toàn","Seller cần ngân hàng bảo lãnh trả thay tuyệt đối"],"correct":0,"explanation":"D/P là lựa chọn trung gian giữa Open Account và L/C nhưng vẫn có nguy cơ Buyer từ chối nhận hàng.","source":"DB tr.24–26","level":"Trung bình"},{"id":"TF031","category":"lc","question":"Commercial Documentary Credit / L/C là gì?","options":["Cam kết có điều kiện của issuing bank thanh toán khi xuất trình chứng từ phù hợp","Hợp đồng mua bán giữa hai doanh nghiệp","Bảo hiểm hàng trong vận chuyển","Bảo lãnh mọi sai sót chất lượng"],"correct":0,"explanation":"L/C là undertaking độc lập và dựa vào complying presentation.","source":"DB tr.26–28","level":"Cơ bản"},{"id":"TF032","category":"lc","question":"Applicant trong L/C thường là ai?","options":["Buyer/Importer đề nghị ngân hàng mở L/C","Seller hưởng tiền","Hãng tàu","Bên kiểm toán"],"correct":0,"explanation":"Applicant thông thường là Buyer mở L/C cho Seller.","source":"DB tr.26","level":"Cơ bản"},{"id":"TF033","category":"lc","question":"Beneficiary trong L/C thường là ai?","options":["Seller/Exporter được hưởng tiền theo L/C","Buyer yêu cầu mở","Ngân hàng phát hành","Đại lý vận tải"],"correct":0,"explanation":"Beneficiary hưởng cam kết của ngân hàng khi đáp ứng điều kiện.","source":"DB tr.26","level":"Cơ bản"},{"id":"TF034","category":"lc","question":"Issuing Bank là ngân hàng gì?","options":["Ngân hàng phát hành L/C theo yêu cầu Applicant","Ngân hàng bắt buộc vận chuyển hàng","Ngân hàng bảo hiểm hàng","Ngân hàng đòi nợ hãng tàu"],"correct":0,"explanation":"Issuing Bank cam kết honour theo điều kiện L/C.","source":"DB tr.26; 30–31","level":"Cơ bản"},{"id":"TF035","category":"lc","question":"Advising Bank làm nhiệm vụ chính nào?","options":["Thông báo L/C cho Beneficiary và kiểm tra tính xác thực bề ngoài của L/C","Luôn phải trả tiền thay Issuing Bank","Luôn xác nhận L/C","Bảo đảm chất lượng sản phẩm"],"correct":0,"explanation":"Advising không đồng nghĩa confirming; vai trò phụ thuộc văn bản và thỏa thuận.","source":"DB tr.27; 30","level":"Trung bình"},{"id":"TF036","category":"lc","question":"Complying Presentation là gì?","options":["Bộ chứng từ phù hợp điều kiện L/C, UCP áp dụng và thực hành chuẩn","Hàng nhất định không có lỗi thực tế","Buyer phải hài lòng chủ quan","Seller chỉ cần giao hàng mà không xuất trình gì"],"correct":0,"explanation":"Ngân hàng kiểm tra chứng từ theo credit, UCP 600 và standard banking practice.","source":"DB tr.26–27","level":"Trung bình"},{"id":"TF037","category":"lc","question":"L/C và Sales Contract có quan hệ pháp lý thế nào?","options":["L/C độc lập với hợp đồng mua bán cơ sở","L/C và hợp đồng là cùng một tài liệu","Ngân hàng phải xử lý mọi tranh chấp chất lượng trước khi trả","Sales Contract không cần tồn tại trong mọi hoàn cảnh"],"correct":0,"explanation":"Tính độc lập là nguyên tắc trung tâm của documentary credits.","source":"DB tr.28","level":"Trung bình"},{"id":"TF038","category":"lc","question":"Irrevocable L/C nghĩa là gì?","options":["L/C không được đơn phương sửa/hủy khi thiếu các chấp thuận cần thiết","Ngân hàng có thể hủy bất kỳ lúc nào","Seller có thể đổi tiền hàng tùy ý","L/C chỉ hiệu lực một ngày"],"correct":0,"explanation":"UCP 600 vận hành với Irrevocable credits; sửa/hủy cần tuân thủ các chấp thuận liên quan.","source":"DB tr.27","level":"Trung bình"},{"id":"TF039","category":"lc","question":"Revocable L/C là gì?","options":["Loại L/C có thể bị hủy/sửa theo cấu trúc lịch sử, không phải chuẩn UCP 600 hiện tại","L/C mặc nhiên được confirming bank xác nhận","L/C chỉ dành cho nội địa","L/C luôn đi kèm forfaiting"],"correct":0,"explanation":"Deutsche Bank nêu revocable rất hiếm và không được khuyến nghị; UCP hiện hành không duy trì loại này.","source":"DB tr.27","level":"Trung bình"},{"id":"TF040","category":"lc","question":"Confirmed L/C bổ sung điều gì?","options":["Cam kết độc lập của confirming bank khi chứng từ xuất trình phù hợp","Tự động xóa mọi rủi ro gian lận chứng từ","Biến ngân hàng thành chủ sở hữu hàng","Buyer được hủy hợp đồng tùy ý"],"correct":0,"explanation":"Confirmation hữu ích khi Seller lo ngại issuing bank hoặc country risk.","source":"DB tr.27","level":"Trung bình"},{"id":"TF041","category":"lc","question":"Sight L/C khác Usance L/C chủ yếu ở yếu tố nào?","options":["Thời điểm thanh toán: sight so với maturity/deferred","Số lượng ngân hàng luôn khác nhau","Bắt buộc vận chuyển đường biển so với hàng không","Có hoặc không có hợp đồng mua bán"],"correct":0,"explanation":"Sight thường thanh toán khi xuất trình phù hợp; usance thanh toán vào kỳ hạn.","source":"DB tr.26–31","level":"Trung bình"},{"id":"TF042","category":"lc","question":"Red Clause L/C có đặc điểm gì?","options":["Cho phép ứng trước cho Beneficiary trước khi giao hàng theo điều kiện L/C","Tự động giảm giá hàng","Chỉ dùng trong thanh toán thuế","Cho phép Buyer không trả tiền sau giao hàng"],"correct":0,"explanation":"Red Clause hỗ trợ pre-export financing, mua nguyên liệu, sản xuất.","source":"DB tr.28","level":"Trung bình"},{"id":"TF043","category":"lc","question":"Green Clause L/C có thể khác Red Clause thông thường ở điểm nào?","options":["Khoản ứng trước có thể được bảo đảm bằng chứng từ kho/hàng lưu kho","Không cho phép ứng trước","Luôn có 3 issuing banks","Bắt buộc là bảo lãnh bảo hành"],"correct":0,"explanation":"Deutsche Bank ghi Green Clause cho phép advance và storage in bank name làm security.","source":"DB tr.28","level":"Trung bình"},{"id":"TF044","category":"lc","question":"Revolving L/C được dùng chủ yếu khi nào?","options":["Giao dịch lặp lại, hạn mức L/C tái lập theo thời gian hoặc giá trị","Chỉ một giao dịch duy nhất","Phát hành bảo lãnh dự thầu","Buyer chưa có hợp đồng"],"correct":0,"explanation":"Revolving giúp tránh mở L/C mới cho mỗi kỳ mua hàng tương tự.","source":"DB tr.29","level":"Trung bình"},{"id":"TF045","category":"lc","question":"Transferable L/C cần điều kiện trọng yếu nào?","options":["L/C phải ghi rõ là transferable","Bất kỳ L/C nào cũng chuyển tự do","Second beneficiary có quyền chuyển tiếp không hạn chế","Không cần ngân hàng đồng ý vai trò chuyển nhượng"],"correct":0,"explanation":"Chỉ L/C được ghi rõ transferable mới cho phép chuyển theo điều kiện UCP.","source":"DB tr.29","level":"Trung bình"},{"id":"TF046","category":"lc","question":"Back-to-back L/C có cấu trúc như thế nào?","options":["Hai L/C tách biệt: master L/C và L/C mở cho supplier","Một L/C đổi tên beneficiary","Một APG thay thế L/C","Không có ngân hàng tham gia"],"correct":0,"explanation":"Back-to-back dùng cho middleman với hai cam kết độc lập, rủi ro khác transferable L/C.","source":"DB tr.29","level":"Trung bình"},{"id":"TF047","category":"lc","question":"Điểm khác nhau cốt lõi giữa Transferable và Back-to-back L/C?","options":["Transferable dựa trên một L/C được chuyển; Back-to-back dùng hai L/C riêng biệt","Cả hai luôn có một L/C duy nhất","Cả hai luôn không cần ngân hàng","Transferable luôn là bảo lãnh, không phải L/C"],"correct":0,"explanation":"Cấu trúc pháp lý và rủi ro ngân hàng khác nhau.","source":"DB tr.29","level":"Trung bình"},{"id":"TF048","category":"lc","question":"Ngày Latest Shipment Date trong L/C dùng để kiểm tra gì?","options":["Hàng có được giao trong thời hạn theo chứng từ vận tải được yêu cầu không","Ngày Buyer hoàn thành KYC","Ngày mở tài khoản ngân hàng","Ngày bảo hiểm hết hiệu lực trong mọi giao dịch"],"correct":0,"explanation":"Phải xác định shipment date theo yêu cầu L/C và chứng từ vận tải áp dụng.","source":"Ứng dụng UCP 600; DB tr.26–31","level":"Nâng cao"},{"id":"TF049","category":"lc","question":"Nếu Buyer và Seller ở cùng một ngân hàng tại Việt Nam thì L/C nội địa có thể triển khai không?","options":["Có thể theo sản phẩm, quy định và phê duyệt của ngân hàng; vẫn phải thẩm định chứng từ/rủi ro","Không bao giờ được vì chỉ có một ngân hàng","Tự động không cần lập hợp đồng","L/C mặc nhiên được trả dù chứng từ sai"],"correct":0,"explanation":"Cùng ngân hàng có thể xử lý cả hai vai trò nghiệp vụ trong một hệ thống; rủi ro và kiểm soát vẫn tồn tại.","source":"Mở rộng Việt Nam (không phải ví dụ DB)","level":"Nâng cao"},{"id":"TF050","category":"lc","question":"Ai thường đề nghị mở Commercial L/C?","options":["Buyer/Applicant đề nghị Issuing Bank theo thỏa thuận với Seller","Seller tự mở L/C đứng tên Buyer","Hãng tàu đề nghị","Công ty bảo hiểm bắt buộc mở"],"correct":0,"explanation":"Hai bên chốt phương thức trong sales contract; Buyer nộp application.","source":"DB tr.26; 30","level":"Nâng cao"},{"id":"TF051","category":"sblc","question":"Standby Letter of Credit (SBLC) khác Commercial L/C về chức năng điển hình như thế nào?","options":["SBLC thường bảo đảm dự phòng cho nghĩa vụ; Commercial L/C thường là công cụ thanh toán","SBLC chỉ dùng để kiểm đếm hàng","Commercial L/C không có ngân hàng","SBLC luôn được trả dù chưa có demand"],"correct":0,"explanation":"SBLC thông thường được gọi khi có nghĩa vụ không được thực hiện; Direct-Pay standby là ngoại lệ.","source":"DB tr.37–38","level":"Cơ bản"},{"id":"TF052","category":"sblc","question":"Bộ quy tắc nào Deutsche Bank xem là phù hợp nhất cho SBLC?","options":["ISP98","URC 522","Incoterms 2020","URF 800"],"correct":0,"explanation":"ISP98 được thiết kế cho standby, dù các bên có thể áp dụng bộ quy tắc khác nếu phù hợp.","source":"DB tr.37; 42","level":"Cơ bản"},{"id":"TF053","category":"sblc","question":"Performance Standby hỗ trợ nghĩa vụ gì?","options":["Thực hiện đúng nghĩa vụ hợp đồng","Thanh toán ngay tiền thuế VAT","Chốt tỷ giá ngoại tệ","Phát hành B/L"],"correct":0,"explanation":"Performance standby bảo đảm nếu applicant không thực hiện nghĩa vụ được bảo đảm.","source":"DB tr.38","level":"Cơ bản"},{"id":"TF054","category":"sblc","question":"Advance Payment Standby bảo vệ rủi ro nào?","options":["Người nhận tiền ứng trước không hoàn trả theo điều kiện cam kết","Ngoại tệ tăng giá","Kho chứa hàng bị khóa","Invoice bị in nhầm"],"correct":0,"explanation":"Đây là standby bảo vệ tiền advance/down payment.","source":"DB tr.38","level":"Cơ bản"},{"id":"TF055","category":"sblc","question":"Bid/Tender Standby dùng trong hoàn cảnh nào?","options":["Bảo đảm bên dự thầu tuân thủ cam kết trong thời gian đấu thầu","Đóng phí vận tải đường biển","Chiết khấu invoice hàng ngày","Chứng minh đã có C/O"],"correct":0,"explanation":"Bid standby liên quan đến việc không rút/sửa đề xuất trái điều kiện.","source":"DB tr.38","level":"Trung bình"},{"id":"TF056","category":"sblc","question":"Counter Standby có thể được sử dụng để làm gì?","options":["Hỗ trợ ngân hàng khác phát hành cam kết/guarantee/standby","Mua ngoại tệ giao ngay","Trả phí lưu container","Tự động chuyển L/C thành invoice"],"correct":0,"explanation":"Counter standby là cam kết hỗ trợ một ngân hàng khác phát hành nghĩa vụ.","source":"DB tr.38","level":"Trung bình"},{"id":"TF057","category":"sblc","question":"Financial Standby bảo đảm loại nghĩa vụ nào?","options":["Nghĩa vụ tài chính trả hoặc hoàn trả tiền","Bắt buộc giao tàu đúng lịch","Chỉ tiền phí bảo hiểm tàu","Nghĩa vụ kiểm tra hàng trước giao"],"correct":0,"explanation":"Financial standby hỗ trợ payment/repayment obligation.","source":"DB tr.38","level":"Trung bình"},{"id":"TF058","category":"sblc","question":"Insurance Standby được thiết kế để hỗ trợ loại nghĩa vụ nào?","options":["Nghĩa vụ liên quan hoạt động bảo hiểm/tái bảo hiểm","Chứng nhận xuất xứ","Cho vay theo trữ lượng dầu","Thay thế hợp đồng vận chuyển"],"correct":0,"explanation":"Deutsche Bank liệt kê Insurance standby cho obligations liên quan insurance/reinsurance.","source":"DB tr.38","level":"Trung bình"},{"id":"TF059","category":"sblc","question":"Direct-Pay Standby có đặc điểm khác biệt nào?","options":["Có thể là phương tiện thanh toán chính, không nhất thiết gắn với default","Chỉ thanh toán nếu applicant phá sản","Chỉ dành cho D/P","Luôn là cargo insurance"],"correct":0,"explanation":"Direct-Pay là ngoại lệ của vai trò dự phòng mặc định.","source":"DB tr.38","level":"Trung bình"},{"id":"TF060","category":"sblc","question":"Commercial Standby được dùng chủ yếu cho trường hợp nào?","options":["Bảo đảm tiền hàng/dịch vụ Buyer chưa trả theo cơ chế khác như Open Account","Bắt buộc thay thế Packing List","Định giá hàng tồn kho","Đòi hoàn lại phí chuyển tiền"],"correct":0,"explanation":"Commercial standby hỗ trợ nghĩa vụ thanh toán hàng hóa/dịch vụ theo giao dịch khác.","source":"DB tr.38","level":"Trung bình"},{"id":"TF061","category":"sblc","question":"Ngân hàng xử lý một yêu cầu gọi SBLC dựa chủ yếu vào yếu tố nào?","options":["Điều khoản SBLC và bộ chứng từ/demand được quy định","Kiểm định trực tiếp mọi máy móc","Yêu cầu Seller đóng thêm thuế tùy ý","Không cần xem expiry"],"correct":0,"explanation":"Văn bản cam kết, presentation requirements và expiry rất quan trọng.","source":"DB tr.37–39","level":"Trung bình"},{"id":"TF062","category":"guarantee","question":"L/G (Letter of Guarantee) là gì trong bối cảnh này?","options":["Cam kết bảo lãnh nghĩa vụ theo điều kiện do ngân hàng/bên bảo lãnh phát hành","Vận đơn đường biển","Hóa đơn thương mại","Hợp đồng mua bán ngoại tệ giao ngay"],"correct":0,"explanation":"Cần đọc văn bản cụ thể: L/G rộng hơn demand guarantee và không mặc nhiên chịu URDG 758.","source":"DB tr.32–36 + diễn giải","level":"Cơ bản"},{"id":"TF063","category":"guarantee","question":"Demand Guarantee được thanh toán trên cơ sở gì?","options":["Demand và chứng từ đáp ứng các điều kiện của bảo lãnh","Chỉ cần Buyer nói hàng không đẹp","Hợp đồng mua bán tự động kích hoạt thanh toán","Ngân hàng phải bán hàng lấy tiền trước"],"correct":0,"explanation":"Một demand guarantee có tính độc lập và ngân hàng xem điều kiện xuất trình theo văn bản.","source":"DB tr.32–33","level":"Cơ bản"},{"id":"TF064","category":"guarantee","question":"Theo URDG 758, demand thường cần kèm nội dung gì, trừ khi quy định khác cho phép?","options":["Tuyên bố của beneficiary nêu applicant vi phạm nghĩa vụ như thế nào","Báo cáo định giá cổ phiếu","Vận đơn hàng không của ngân hàng","Giấy chứng nhận giá vàng"],"correct":0,"explanation":"Đối với bảo lãnh chịu URDG 758, thường phải có statement of breach theo điều khoản áp dụng.","source":"DB tr.33; 42","level":"Cơ bản"},{"id":"TF065","category":"guarantee","question":"Bid Bond / Tender Guarantee có mục đích chính nào?","options":["Bảo đảm người dự thầu không rút/sửa hồ sơ dự thầu trái điều kiện","Bảo đảm hàng hóa không hỏng trên biển","Khóa tỷ giá","Bảo đảm Buyer không phá sản trong mọi trường hợp"],"correct":0,"explanation":"Bid guarantee gắn với giai đoạn dự thầu.","source":"DB tr.34","level":"Cơ bản"},{"id":"TF066","category":"guarantee","question":"Deutsche Bank cho biết Bid Guarantee thường khoảng bao nhiêu giá trị thầu?","options":["2–5%","100–120%","40–60%","0% trong mọi trường hợp"],"correct":0,"explanation":"Tỷ lệ 2–5% chỉ là mức điển hình được tài liệu nêu, không phải quy định bắt buộc chung.","source":"DB tr.34","level":"Trung bình"},{"id":"TF067","category":"guarantee","question":"Performance Guarantee bảo đảm điều gì?","options":["Bên được bảo lãnh thực hiện nghĩa vụ hợp đồng; trả tiền khi claim hợp lệ do không thực hiện","Bảo đảm mọi giao dịch FX sinh lãi","Bảo đảm Buyer thanh toán trước","Chỉ phát hành cho bảo hiểm tàu"],"correct":0,"explanation":"Performance thường dùng trong xây dựng, hàng hóa, dịch vụ và dự án.","source":"DB tr.34","level":"Trung bình"},{"id":"TF068","category":"guarantee","question":"Advance Payment Guarantee (APG) nhằm bảo vệ ai?","options":["Buyer đã ứng tiền cho Seller theo hợp đồng","Seller muốn tăng tỷ giá","Hãng tàu muốn giảm phí cảng","Công ty bảo hiểm muốn thu lãi"],"correct":0,"explanation":"APG nhằm hoàn trả advance khi trường hợp bảo đảm xảy ra theo điều kiện.","source":"DB tr.34","level":"Trung bình"},{"id":"TF069","category":"guarantee","question":"APG có tự động cấp tiền cho Seller không?","options":["Không, APG là cam kết bảo lãnh; nguồn ứng trước thường từ Buyer","Có, APG luôn giải ngân 100% giá hợp đồng","Có, APG chính là factoring","Có, APG tự biến thành khoản vay RBL"],"correct":0,"explanation":"Cần phân biệt dòng tiền advance với cam kết của bank.","source":"Mở rộng thực hành; DB tr.23, 34","level":"Trung bình"},{"id":"TF070","category":"guarantee","question":"Warranty/Maintenance Guarantee được sử dụng ở giai đoạn nào?","options":["Thời gian bảo hành/bảo trì sau khi bàn giao theo hợp đồng","Chỉ trước khi nộp hồ sơ dự thầu","Chỉ trong ngày mở L/C","Chỉ khi đổi tiền Spot"],"correct":0,"explanation":"Bảo lãnh bảo hành liên quan các lỗi, chất lượng trong thời hạn được quy định.","source":"DB tr.35","level":"Trung bình"},{"id":"TF071","category":"guarantee","question":"Retention Guarantee giúp giải quyết vấn đề gì?","options":["Thay khoản tiền Buyer giữ lại để bảo đảm nghĩa vụ/khuyết tật sau hoàn thành","Thay thế mọi khoản vay vốn lưu động","Bảo hiểm chênh lệch tỷ giá","Bảo đảm container không đến muộn"],"correct":0,"explanation":"Retention guarantee có thể cho phép Seller/contractor nhận tiền thay vì bị giữ lại.","source":"DB tr.35","level":"Trung bình"},{"id":"TF072","category":"guarantee","question":"Direct Demand Guarantee được phát hành theo luồng nào?","options":["Seller/Applicant → ngân hàng bảo lãnh trực tiếp → Buyer/Beneficiary","Seller → ngân hàng A → ngân hàng B phát hành lại cho Buyer trong mọi trường hợp","Buyer → hãng tàu → bảo hiểm","Ngân hàng → sàn FX → Seller"],"correct":0,"explanation":"Trong cấu trúc direct, ngân hàng của seller phát hành trực tiếp cho beneficiary.","source":"DB tr.35–36","level":"Trung bình"},{"id":"TF073","category":"guarantee","question":"Indirect Demand Guarantee bao gồm bước riêng nào?","options":["Ngân hàng Seller phát hành counter-guarantee để ngân hàng địa phương phát hành guarantee","Seller tự ký tên thay ngân hàng","Buyer phải thanh toán trước toàn bộ","Hãng tàu phải chấp nhận bill of exchange"],"correct":0,"explanation":"Indirect có hai ngân hàng tham gia trong luồng cam kết; beneficiary nhận guarantee của local guarantor.","source":"DB tr.35–36","level":"Trung bình"},{"id":"TF074","category":"guarantee","question":"Nếu Buyer yêu cầu bảo lãnh do ngân hàng tại nước mình phát hành, cấu trúc nào thường phù hợp?","options":["Indirect Guarantee với ngân hàng địa phương và counter-guarantee","Open Account không bảo đảm","FX Swap","Straight B/L không có bảo lãnh"],"correct":0,"explanation":"Ngân hàng Seller có thể hỗ trợ bằng counter-guarantee cho local bank.","source":"DB tr.35–36","level":"Trung bình"},{"id":"TF075","category":"guarantee","question":"Chú ý nào đúng nhất khi xem ngày hết hạn của Demand Guarantee?","options":["Demand phải được xuất trình trong thời hạn và tại nơi/quy trình quy định","Có thể gọi vô hạn sau expiry","Hết hạn không quan trọng nếu Buyer giận Seller","Bảo lãnh luôn vô thời hạn"],"correct":0,"explanation":"Expiry date/event và place/mode of presentation là điều khoản cốt yếu.","source":"DB tr.33","level":"Nâng cao"},{"id":"TF076","category":"guarantee","question":"Payment Guarantee khác Performance Guarantee ở điểm chính nào?","options":["Payment bảo đảm nghĩa vụ trả tiền; Performance bảo đảm nghĩa vụ thực hiện","Cả hai bắt buộc dùng để mua ngoại tệ","Payment là vận đơn còn Performance là hóa đơn","Không khác nhau ở đối tượng nghĩa vụ"],"correct":0,"explanation":"Cần chọn đúng loại bảo lãnh theo risk cần mitigated.","source":"Diễn giải cấu trúc L/G; DB tr.32–35","level":"Nâng cao"},{"id":"TF077","category":"guarantee","question":"Demand Guarantee có độc lập với Sales Contract hay không?","options":["Thông thường độc lập trong phạm vi văn bản bảo lãnh","Luôn đồng nhất hoàn toàn với hợp đồng mua bán","Chỉ độc lập nếu Seller có APG","Không bao giờ độc lập"],"correct":0,"explanation":"Tính độc lập khiến ngân hàng xem demand theo text cam kết, không xét lại toàn bộ tranh chấp cơ sở.","source":"DB tr.32–33","level":"Nâng cao"},{"id":"TF078","category":"scf","question":"SCF là viết tắt của gì?","options":["Supply Chain Finance","Shipping Credit Forward","Structured Cash Futures","Sales Contract Funding"],"correct":0,"explanation":"SCF là nhóm kỹ thuật tài trợ dòng hàng và vốn lưu động trong chuỗi cung ứng.","source":"DB tr.45–48","level":"Cơ bản"},{"id":"TF079","category":"scf","question":"SCF thường gắn với giao dịch theo phương thức nào?","options":["Open Account","Chỉ 100% Advance Payment","Chỉ tài trợ dự án bất động sản","Chỉ FX Spot"],"correct":0,"explanation":"SCF thường liên quan tài trợ open-account flows along supply chain.","source":"DB tr.45","level":"Cơ bản"},{"id":"TF080","category":"scf","question":"Receivables Discounting là gì?","options":["Seller bán một hoặc nhiều khoản phải thu với mức chiết khấu để nhận tiền sớm","Buyer hủy toàn bộ đơn hàng","Bank bảo hiểm hàng","Seller vay theo trữ lượng dầu"],"correct":0,"explanation":"Đối tượng là receivables, thường thể hiện bằng outstanding invoices.","source":"DB tr.49","level":"Cơ bản"},{"id":"TF081","category":"scf","question":"Factoring về cơ bản là gì?","options":["Seller bán khoản phải thu cho factor; factor thường quản lý/thu hồi công nợ","Mua lại cổ phần Seller","Chuyển giao quyền khai thác dầu","Thư tín dụng trả ngay"],"correct":0,"explanation":"Factoring có thể bao gồm ứng trước, quản lý danh mục con nợ và thu nợ.","source":"DB tr.51","level":"Cơ bản"},{"id":"TF082","category":"scf","question":"Forfaiting nổi bật ở đặc tính nào?","options":["Mua nghĩa vụ thanh toán tương lai trên cơ sở without recourse","Luôn có recourse Seller","Chỉ mua nguyên liệu trước giao hàng","Không liên quan công cụ thanh toán"],"correct":0,"explanation":"Forfaiting thường không truy đòi về rủi ro thanh toán thông thường theo hợp đồng, nhưng vẫn có các nghĩa vụ khác của Seller.","source":"DB tr.49–50","level":"Trung bình"},{"id":"TF083","category":"scf","question":"So sánh Factoring và Forfaiting: nhận định nào đúng?","options":["Factoring thường dùng invoices ngắn hạn và thu nợ; forfaiting thường là nghĩa vụ chuyển nhượng lớn/dài hơn","Factoring luôn chỉ dài hạn 10 năm","Forfaiting luôn có truy đòi Seller đối với default","Hai kỹ thuật hoàn toàn giống nhau"],"correct":0,"explanation":"Tài liệu DB nêu factoring thường advance invoice; forfaiting nhiều giao dịch >180 ngày và trung/dài hạn.","source":"DB tr.49–51","level":"Trung bình"},{"id":"TF084","category":"scf","question":"“With recourse factoring” thường có nghĩa gì?","options":["Factor có quyền truy đòi Seller theo các điều kiện hợp đồng nếu debtor không trả","Factor chịu mọi tổn thất dù Seller gian lận","Ngân hàng phát hành L/C thay Buyer","Buyer không cần hóa đơn"],"correct":0,"explanation":"Recourse là quyền quay lại yêu cầu Seller chịu nghĩa vụ theo điều kiện chuyển nhượng.","source":"Mở rộng SCF; DB tr.51","level":"Trung bình"},{"id":"TF085","category":"scf","question":"“Non-recourse factoring” có nghĩa gì theo cách hiểu phù hợp?","options":["Factor nhận một số rủi ro không thanh toán của debtor theo hợp đồng, vẫn có ngoại lệ","Seller miễn mọi nghĩa vụ kể cả gian lận","Factor luôn mất quyền thu nợ","Buyer không còn nghĩa vụ thanh toán"],"correct":0,"explanation":"Cần xem giới hạn credit risk, dispute, dilution, fraud, representations and warranties.","source":"Mở rộng SCF; DB tr.51","level":"Trung bình"},{"id":"TF086","category":"scf","question":"Two-factor International Factoring là gì?","options":["Factor nước xuất khẩu làm việc với factor địa phương của nước Buyer","Hai Seller cùng phát hành L/C","Hai ngân hàng bắt buộc tài trợ một khoản vay dầu khí","Buyer thanh toán hai lần cùng invoice"],"correct":0,"explanation":"Two-factor giúp dùng local factor để phục vụ và thu nợ tại nước Buyer.","source":"DB tr.51","level":"Trung bình"},{"id":"TF087","category":"scf","question":"Payables Finance / Reverse Factoring thường do bên nào dẫn dắt?","options":["Buyer-led programme","Seller-led với chỉ Seller tham gia","Hãng tàu chủ trì","Cơ quan hải quan chủ trì"],"correct":0,"explanation":"Supplier nhận tiền sớm trên khoản phải thu đã phù hợp, chi phí thường dựa tín nhiệm Buyer.","source":"DB tr.52","level":"Trung bình"},{"id":"TF088","category":"scf","question":"Payables Finance giúp Seller cụ thể thế nào?","options":["Có thể nhận tiền sớm trước hạn hóa đơn sau khi khoản phải thu đủ điều kiện","Không cần giao hàng","Không còn phải phát hành invoice","Luôn tránh được mọi phí tài trợ"],"correct":0,"explanation":"Payables finance tối ưu working capital Buyer/Supplier theo chương trình.","source":"DB tr.52","level":"Trung bình"},{"id":"TF089","category":"scf","question":"Loan/Advance against Receivables khác bán hẳn khoản phải thu ở điểm cơ bản nào?","options":["Là khoản tài trợ/vay dựa trên các receivables, thay vì mặc định mua đứt","Bắt buộc xuất khẩu dầu","Không có nghĩa vụ hoàn trả trong mọi trường hợp","Chỉ xảy ra sau khi buyer trả tiền"],"correct":0,"explanation":"Cần xem security/assignment và recourse, không đồng nhất với outright receivables sale.","source":"DB tr.52","level":"Trung bình"},{"id":"TF090","category":"scf","question":"Distributor Finance nhằm tài trợ cho ai?","options":["Nhà phân phối cần vốn giữ hàng để bán lại","Người bảo lãnh dự thầu","Công ty khai thác dầu để thăm dò","Người mua quyền chọn ngoại tệ"],"correct":0,"explanation":"Distributor finance hỗ trợ gap từ mua/giữ hàng tới thu tiền bán cho end customer.","source":"DB tr.53","level":"Trung bình"},{"id":"TF091","category":"scf","question":"Loan/Advance against Inventory dùng tài sản nền tảng nào?","options":["Hàng tồn kho đủ điều kiện được kiểm soát/bảo đảm","Chỉ hợp đồng bảo hiểm xe","Chỉ tài sản trí tuệ chưa định giá","Chỉ tín phiếu ngân hàng trung ương"],"correct":0,"explanation":"Financier có thể nhận security interest và quyền kiểm soát inventory/warehouse.","source":"DB tr.53","level":"Trung bình"},{"id":"TF092","category":"scf","question":"Pre-shipment Finance dùng tiền vào giai đoạn nào?","options":["Trước giao hàng để mua nguyên liệu/sản xuất","Chỉ sau khi Buyer đã thanh toán hết","Chỉ khi hàng đã vào kho Buyer","Chỉ để mua EUR giao ngay"],"correct":0,"explanation":"Pre-shipment finance tài trợ sourcing/manufacture/processing trước khi giao hàng.","source":"DB tr.53","level":"Trung bình"},{"id":"TF093","category":"scf","question":"Bank Payment Obligation (BPO) liên quan chủ yếu đến cơ chế nào?","options":["Cam kết ngân hàng dựa trên đối chiếu dữ liệu điện tử theo điều kiện","Hối phiếu giấy bắt buộc được Buyer chấp nhận","Đổi ngoại tệ Spot trong 2 ngày","Bảo hiểm lô hàng"],"correct":0,"explanation":"DB mô tả BPO liên quan electronic data matching và URBPO.","source":"DB tr.43; 48","level":"Trung bình"},{"id":"TF094","category":"scf","question":"SCF tối ưu chủ yếu chỉ tiêu tài chính nào?","options":["Working Capital và Liquidity","Chỉ vốn cổ phần dài hạn","Chỉ số lượng tàu","Chỉ thuế tiêu thụ đặc biệt"],"correct":0,"explanation":"SCF giúp đẩy nhanh chuyển đổi các khoản phải thu/hàng tồn thành nguồn vốn.","source":"DB tr.45–48","level":"Trung bình"},{"id":"TF095","category":"scf","question":"Seller có nhiều invoice trả sau 60 ngày và muốn factor theo dõi thu nợ: sản phẩm hợp lý?","options":["Factoring","RBL","Bid Guarantee","FX Swap đơn thuần"],"correct":0,"explanation":"Factoring kết hợp mua receivables với dịch vụ quản lý, thu hồi công nợ.","source":"DB tr.51","level":"Trung bình"},{"id":"TF096","category":"scf","question":"Seller bán máy móc theo khoản nợ thanh toán nhiều năm và muốn without recourse: công cụ có thể cân nhắc?","options":["Forfaiting","Inventory finance ngắn hạn đơn thuần","D/P at Sight không kèm tài trợ","Bill of Lading"],"correct":0,"explanation":"Forfaiting thường phù hợp nghĩa vụ thanh toán chuyển nhượng được, kỳ hạn dài hơn.","source":"DB tr.49–50","level":"Trung bình"},{"id":"TF097","category":"scf","question":"Phát biểu nào đúng về “SCF” và “L/C”?","options":["SCF là nhóm giải pháp vốn lưu động; L/C là cam kết thanh toán theo chứng từ, có thể kết hợp","SCF chính là một loại L/C","L/C chính là factoring","SCF chỉ dùng cho vận chuyển đường biển"],"correct":0,"explanation":"Hai nhóm có mục tiêu chính khác nhau nhưng phối hợp được theo cấu trúc giao dịch.","source":"DB tr.26–31; 45–53","level":"Trung bình"},{"id":"TF098","category":"funding","question":"Seller chưa có tiền mua nguyên liệu nhưng có Sales Contract: giải pháp vay nào phù hợp?","options":["Pre-shipment Finance","Receivables discounting của invoice chưa tồn tại mặc định","Cargo insurance","FX Spot đơn thuần"],"correct":0,"explanation":"Ngân hàng có thể thẩm định hợp đồng, năng lực sản xuất và cấp vốn trước shipment.","source":"DB tr.53","level":"Cơ bản"},{"id":"TF099","category":"funding","question":"Seller vay Pre-shipment Finance và Buyer cuối cùng không trả: nghĩa vụ vay Seller thế nào?","options":["Seller vẫn phải trả ngân hàng theo hợp đồng tín dụng","Khoản vay tự động xóa","Buyer bắt buộc là người vay thay Seller","Ngân hàng phải chịu toàn bộ mà không truy đòi"],"correct":0,"explanation":"Nguồn thu xuất khẩu hỗ trợ repayment nhưng không xóa nghĩa vụ của người vay.","source":"Ứng dụng; DB tr.53–54","level":"Cơ bản"},{"id":"TF100","category":"funding","question":"Seller không muốn vay, Buyer sẵn sàng ứng tiền nhưng cần bảo vệ: kết hợp nào hợp lý?","options":["Advance Payment + APG","Open Account thuần túy không điều khoản","RBL + Sea Waybill","Spot FX + Cargo Receipt"],"correct":0,"explanation":"Advance cung cấp tiền; APG bảo vệ khoản tiền ứng trước theo điều kiện.","source":"DB tr.23, 34","level":"Cơ bản"},{"id":"TF101","category":"funding","question":"Red Clause L/C giúp Seller thiếu vốn bằng cách nào?","options":["Cho phép ứng trước trước Shipment theo điều kiện L/C","Giảm thuế hải quan mặc định","Bán lại khoản phải thu sau hạn","Tự động cho phép mọi Buyer hủy hợp đồng"],"correct":0,"explanation":"Red Clause có thể tài trợ nguyên liệu hoặc giai đoạn sản xuất.","source":"DB tr.28","level":"Cơ bản"},{"id":"TF102","category":"funding","question":"BBF là viết tắt của gì?","options":["Borrowing Base Finance","Bank Bill Forward","Buyer Balance Factoring","Bond Backed Forfaiting"],"correct":0,"explanation":"BBF thường tài trợ hàng hóa dựa trên borrowing base của tài sản đủ điều kiện.","source":"DB tr.56–57","level":"Trung bình"},{"id":"TF103","category":"funding","question":"Borrowing Base Finance tài trợ dựa chủ yếu trên các tài sản nào?","options":["Inventory, Receivables, Cash đủ điều kiện theo advance rate","Chỉ lượng nhân viên","Chỉ báo cáo CSR","Chỉ giá cổ phiếu Seller"],"correct":0,"explanation":"BBF tính trên cơ sở tài sản có thể bảo đảm và kiểm soát theo hợp đồng.","source":"DB tr.56","level":"Trung bình"},{"id":"TF104","category":"funding","question":"Với BBF: Facility Limit 500 triệu USD, Borrowing Base 300 triệu USD, số rút tối đa theo ví dụ DB là bao nhiêu?","options":["300 triệu USD","500 triệu USD","800 triệu USD","200 triệu USD"],"correct":0,"explanation":"Hạn mức rút = min(facility amount, borrowing base).","source":"DB tr.56","level":"Trung bình"},{"id":"TF105","category":"funding","question":"Nếu BBF dư nợ 100 tỷ nhưng borrowing base giảm xuống 80 tỷ, thông thường bên vay phải làm gì?","options":["Khắc phục thiếu hụt: bổ sung tài sản/cash hoặc trả bớt nợ theo điều kiện","Được tự động rút thêm 20 tỷ","Không cần hành động","Ngân hàng phải phát hành L/C mới ngay"],"correct":0,"explanation":"Borrowing-base shortfall thường yêu cầu cure trong thời hạn quy định.","source":"DB tr.57","level":"Trung bình"},{"id":"TF106","category":"funding","question":"RBL là viết tắt của gì?","options":["Reserve-Based Lending","Receivables Bill Lending","Risk Bank Limit","Revolving Bill Liability"],"correct":0,"explanation":"RBL tập trung vào tài trợ dầu khí dựa trên trữ lượng và dòng tiền dự kiến.","source":"DB tr.57","level":"Trung bình"},{"id":"TF107","category":"funding","question":"RBL thường áp dụng cho lĩnh vực nào?","options":["Thăm dò và khai thác dầu khí (oil & gas upstream)","Bán lẻ tạp hóa","Dịch vụ ăn uống thông thường","Thanh toán thẻ cá nhân"],"correct":0,"explanation":"RBL dựa trên NPV của dòng tiền từ reserves theo mô hình và reserve reports.","source":"DB tr.57","level":"Trung bình"},{"id":"TF108","category":"funding","question":"RBL tính borrowing base chủ yếu từ yếu tố nào?","options":["NPV dòng tiền dự kiến từ trữ lượng tài sản được chấp thuận","Chỉ tổng số hóa đơn bán hàng chưa có kỳ hạn","Số nhân sự toàn doanh nghiệp","Chỉ Issue Date của B/L"],"correct":0,"explanation":"RBL sử dụng ngân sách/giá dự báo, báo cáo trữ lượng độc lập và các coverage ratios.","source":"DB tr.57","level":"Trung bình"},{"id":"TF109","category":"funding","question":"PXF viết đầy đủ là gì?","options":["Pre-export Finance","Payment Exchange Forward","Preferred Export Factoring","Post-expiry Finance"],"correct":0,"explanation":"PXF thường là khoản vay cho producer/exporter dựa dòng tiền xuất khẩu.","source":"DB tr.54–55","level":"Trung bình"},{"id":"TF110","category":"funding","question":"Trong PXF, đối tượng vay chính thường là ai?","options":["Producer / Exporter","Chỉ Off-taker đứng tên vay trong mọi giao dịch","Hãng tàu","Ngân hàng phát hành C/O"],"correct":0,"explanation":"PXF lender cấp tiền cho exporter và thu nợ từ export cash flows theo cấu trúc.","source":"DB tr.54","level":"Trung bình"},{"id":"TF111","category":"funding","question":"Với PXF, lender có full recourse tới ai theo ví dụ Deutsche Bank?","options":["Exporter","Chỉ hãng tàu","Chỉ đơn vị bảo hiểm","Không ai"],"correct":0,"explanation":"Theo DB, exporter vẫn chịu nghĩa vụ hoàn trả khi off-taker vỡ nợ.","source":"DB tr.54","level":"Trung bình"},{"id":"TF112","category":"funding","question":"PPF viết đầy đủ là gì trong tài trợ tài nguyên?","options":["Prepayment Finance","Post Payment Forfaiting","Product Price Forward","Private Payment Facility"],"correct":0,"explanation":"PPF có thể cung cấp vốn qua off-taker để ứng trước cho exporter.","source":"DB tr.54–55","level":"Trung bình"},{"id":"TF113","category":"funding","question":"Luồng Prepayment Finance (PPF) theo mô hình DB là gì?","options":["Lender → Off-taker → ứng trước cho Exporter theo hợp đồng hàng hóa","Lender → hãng tàu → ngân hàng bảo hiểm","Buyer → factor → chiết khấu invoice đã thanh toán","Seller → broker FX → ngân hàng trung ương"],"correct":0,"explanation":"Off-taker đứng giữa lender và exporter trong cấu trúc prepayment; phân chia payment/performance risk phức tạp.","source":"DB tr.55","level":"Trung bình"},{"id":"TF114","category":"funding","question":"Warehouse Finance chủ yếu dựa trên yếu tố nào?","options":["Hàng tồn kho và warehouse receipts được kiểm soát làm tài sản bảo đảm","Hối phiếu Buyer chưa ký","Chỉ báo cáo nhân sự","Chỉ biên lai phí điện thoại"],"correct":0,"explanation":"Kho/chứng từ kho phải được thẩm định để tránh gian lận hoặc cầm cố trùng.","source":"DB tr.58","level":"Nâng cao"},{"id":"TF115","category":"funding","question":"Rủi ro gian lận điển hình trong Warehouse Finance là gì?","options":["Một lô hàng hoặc warehouse receipt bị dùng thế chấp nhiều lần / hàng không tồn tại","Seller trả lương đúng hạn","Tỷ giá cố định","Hàng được bảo hiểm đúng điều kiện"],"correct":0,"explanation":"Tài liệu nhấn mạnh warehouse receipt fraud và double pledging.","source":"DB tr.58","level":"Nâng cao"},{"id":"TF116","category":"funding","question":"BBF khác RBL chủ yếu ở tài sản/dòng tiền nền tảng nào?","options":["BBF: inventory/receivables hàng hóa; RBL: trữ lượng dầu khí và dòng tiền dự kiến","Hai loại đều chỉ dựa vào issue date B/L","RBL chỉ dựa hàng may mặc tồn kho","BBF chỉ dựa trên bảo lãnh dự thầu"],"correct":0,"explanation":"Đối tượng collateral và phương pháp tái định giá của BBF/RBL khác nhau.","source":"DB tr.56–57","level":"Nâng cao"},{"id":"TF117","category":"risk","question":"Funded Trade Finance mô tả đặc tính gì?","options":["Có dòng tiền tài trợ hoặc mua/chuyển tài sản tài chính tại thời điểm giao dịch theo cấu trúc","Chỉ cam kết dự phòng không cấp tiền","Chỉ phí chuyển tiền","Chỉ bảo hiểm không phí"],"correct":0,"explanation":"Funded thường có giải ngân/chiết khấu/mua receivables hoặc funded participation.","source":"DB tr.71–73; mở rộng","level":"Cơ bản"},{"id":"TF118","category":"risk","question":"Unfunded Risk Participation Agreement (RPA) là gì?","options":["Bên tham gia nhận chia sẻ một phần rủi ro theo thỏa thuận mà không nhất thiết cấp tiền ban đầu","Bắt buộc mua hàng tồn kho","Bán hoàn toàn công ty","Là B/L điện tử"],"correct":0,"explanation":"Ngân hàng originator chia risk với participant và chia một phần doanh thu/phí.","source":"DB tr.73","level":"Cơ bản"},{"id":"TF119","category":"risk","question":"Funded sub-participation có đặc điểm nào?","options":["Nhà đầu tư/bank participant chuyển tiền theo agreement để tham gia exposure","Participant chỉ gửi một email cam kết","Không có bất kỳ funding nào","Luôn không thể thu hồi vốn"],"correct":0,"explanation":"Funded participation bao gồm funding theo hợp đồng và phân chia quyền lợi/rủi ro.","source":"DB tr.73","level":"Cơ bản"},{"id":"TF120","category":"risk","question":"Tại sao ngân hàng phân phối (distribute) rủi ro Trade Finance?","options":["Giảm concentration, quản lý vốn/hạn mức và có thêm năng lực tài trợ","Bảo đảm hàng hóa đẹp hơn","Xóa mọi nghĩa vụ pháp lý của Buyer","Không phải kiểm tra KYC"],"correct":0,"explanation":"Distribution giúp chia exposure cho participant/insurer/investor.","source":"DB tr.71–73","level":"Cơ bản"},{"id":"TF121","category":"risk","question":"Insurance Policy trong Risk Distribution được dùng làm gì?","options":["Chuyển một phần rủi ro tổn thất có điều kiện sang insurer","Thay hoàn toàn hợp đồng tín dụng","Đổi USD sang VND","Sản xuất nguyên liệu"],"correct":0,"explanation":"Phạm vi bảo vệ phụ thuộc chính xác điều khoản, trigger và exclusions.","source":"DB tr.72–74","level":"Trung bình"},{"id":"TF122","category":"risk","question":"Phát biểu nào đúng về “risk transfer”?","options":["Rủi ro được phân bổ/chuyển trong phạm vi hợp đồng, không biến mất hoàn toàn","Mọi rủi ro mất đi ngay khi ký giấy","Có RPA thì không cần KYC","Có insurance thì fraud cũng được bảo hiểm mọi lúc"],"correct":0,"explanation":"Residual risks: counterparty, claim, legal, documentation, exclusions.","source":"DB tr.71–75; tổng hợp","level":"Trung bình"},{"id":"TF123","category":"risk","question":"Unfunded participation và funded participation khác nhau ở điểm nào?","options":["Thời điểm và cách cung cấp tiền cho originator/exposure","Cả hai đều nhất thiết là bảo hiểm hàng hóa","Chỉ khác chữ viết tắt, không khác dòng tiền","Funded luôn không có tiền chuyển"],"correct":0,"explanation":"Funded thường có cash funding; unfunded chia rủi ro theo trigger, không nhất thiết ứng tiền ngay.","source":"DB tr.73","level":"Trung bình"},{"id":"TF124","category":"risk","question":"Trong Risk Participation, “originating bank” là ngân hàng gì?","options":["Ngân hàng khởi tạo và tài trợ/cam kết giao dịch gốc","Ngân hàng bảo hiểm tàu bắt buộc","Ngân hàng chỉ xác nhận xuất xứ","Ngân hàng chỉ xử lý payroll"],"correct":0,"explanation":"Originator tạo exposure và có thể chia/bán exposure trên thị trường thứ cấp.","source":"DB tr.71–73","level":"Trung bình"},{"id":"TF125","category":"risk","question":"Một ngân hàng có exposure 100, bán funded 30 và chia unfunded 30; risk retained 40 là ví dụ điều gì?","options":["Phân bổ exposure giữa ngân hàng gốc và đối tác nhận rủi ro","Khẳng định regulatory capital chắc chắn chỉ còn 40","Cơ chế ký quỹ bắt buộc cho mọi L/C","Cách tính lãi FX Forward"],"correct":0,"explanation":"Minh họa phân phối kinh tế; giảm vốn pháp lý phụ thuộc điều kiện công nhận.","source":"Mở rộng; DB tr.71–74","level":"Trung bình"},{"id":"TF126","category":"risk","question":"Unfunded RPA có thể dùng với tổ chức nào?","options":["Ngân hàng khác hoặc đối tác nhận rủi ro/tái bảo hiểm đủ điều kiện","Chỉ công ty vận tải","Chỉ hãng bảo hiểm y tế cá nhân","Chỉ khách du lịch"],"correct":0,"explanation":"DB mô tả các insurer/reinsurer và ngân hàng tham gia các cấu trúc này.","source":"DB tr.71–73","level":"Trung bình"},{"id":"TF127","category":"risk","question":"Bán đứt exposure (outright transfer) có thể dùng tài liệu nào?","options":["Transfer certificate hoặc assignment/assumption agreement phù hợp","Chỉ Packing List","Chỉ Certificate of Origin","Chỉ danh sách lao động"],"correct":0,"explanation":"DB mô tả cash sales qua assignment và transfer documents.","source":"DB tr.73","level":"Nâng cao"},{"id":"TF128","category":"risk","question":"Seller nhận tiền chiết khấu hóa đơn có chắc chắn hết mọi rủi ro không?","options":["Không; cần xem recourse, tranh chấp hàng, gian lận và điều khoản hợp đồng","Có, bất kể gian lận","Có, mọi factor đều bắt buộc chịu toàn bộ","Có, kể cả khoản phải thu không có thật"],"correct":0,"explanation":"Risk allocation phụ thuộc transaction documents và representations/warranties.","source":"DB tr.49–51; diễn giải","level":"Nâng cao"},{"id":"TF129","category":"risk","question":"Credit Risk và FX Risk nên xử lý như thế nào?","options":["Dùng công cụ phù hợp cho từng rủi ro, có thể kết hợp insurance/L/C với hedging","Một FX Forward tự bảo đảm Buyer trả tiền","Một Invoice tự bảo hiểm tỷ giá","Một B/L tự loại trừ mọi default"],"correct":0,"explanation":"Không dùng chung khái niệm hedge FX và mitigate credit default.","source":"DB tr.14–15, 79–80","level":"Nâng cao"},{"id":"TF130","category":"insurance","question":"Trade Credit Insurance bảo vệ chủ yếu rủi ro nào?","options":["Người mua không thanh toán do lý do thương mại/chính trị trong phạm vi đơn bảo hiểm","Hàng bị nước biển làm hỏng trong mọi trường hợp","Tỷ giá tăng 10%","Seller sản xuất chậm mọi trường hợp"],"correct":0,"explanation":"Credit insurance bảo vệ non-payment risk trong phạm vi cover.","source":"DB tr.62–63; 74","level":"Cơ bản"},{"id":"TF131","category":"insurance","question":"Cargo Insurance khác Trade Credit Insurance ở điểm nào?","options":["Cargo bảo hiểm tổn thất vật chất hàng hóa; Credit bảo hiểm không thanh toán","Cả hai đều chỉ bảo hiểm FX","Cargo luôn bảo hiểm Buyer phá sản","Credit chỉ bảo hiểm va chạm tàu"],"correct":0,"explanation":"Cần chọn bảo hiểm theo đúng loại loss.","source":"Ứng dụng; DB tr.14–15, 74","level":"Cơ bản"},{"id":"TF132","category":"insurance","question":"ECA viết đầy đủ là gì?","options":["Export Credit Agency","Exchange Clearing Account","Electronic Cargo Assignment","Equity Conversion Agreement"],"correct":0,"explanation":"ECA là cơ quan/tổ chức tín dụng xuất khẩu, thường hỗ trợ chính sách xuất khẩu quốc gia.","source":"DB tr.61–62","level":"Cơ bản"},{"id":"TF133","category":"insurance","question":"ECA có thể hỗ trợ hoạt động xuất khẩu bằng cách nào?","options":["Tín dụng xuất khẩu, bảo lãnh, bảo hiểm và công cụ hỗ trợ phù hợp chương trình","Bắt buộc phát hành mọi Commercial Invoice","Mua mọi container trên thế giới","Ấn định tỷ giá mọi quốc gia"],"correct":0,"explanation":"Deutsche Bank mô tả official/indirect financing, guarantee, insurance.","source":"DB tr.61–63","level":"Cơ bản"},{"id":"TF134","category":"insurance","question":"Political Risk Insurance (PRI) thường xử lý rủi ro nào?","options":["Chiến tranh, tịch thu tài sản, hạn chế chuyển đổi tiền theo phạm vi bảo hiểm","Đơn hàng bị ghi sai màu ngẫu nhiên","Chênh lệch phí vận chuyển thường ngày","Mọi trường hợp Buyer mặc cả"],"correct":0,"explanation":"Political risk coverage không giống bảo hiểm rủi ro vận tải.","source":"DB tr.62–63; 74","level":"Trung bình"},{"id":"TF135","category":"insurance","question":"Khi mua Trade Credit Insurance, điều gì cần đọc kỹ?","options":["Credit limit, insured events, exclusions, waiting period, claim procedures","Chỉ tên công ty bảo hiểm","Chỉ màu logo","Chỉ tổng số nhân viên Buyer"],"correct":0,"explanation":"Đơn bảo hiểm chỉ trả nếu claim đáp ứng điều kiện và không thuộc loại trừ.","source":"DB tr.72–75; ứng dụng","level":"Trung bình"},{"id":"TF136","category":"insurance","question":"Buyer mất khả năng thanh toán là loại rủi ro nào mà Credit Insurance có thể bảo vệ?","options":["Commercial Risk / Insolvency","Chỉ Cargo Damage","Chỉ FX Basis Risk","Chỉ Sản lượng dầu mỏ"],"correct":0,"explanation":"Buyer insolvency/protracted default là trigger thương mại phổ biến theo điều khoản cover.","source":"DB tr.62; 74","level":"Trung bình"},{"id":"TF137","category":"insurance","question":"Credit Insurance có thể hỗ trợ ngân hàng về mặt nào khi đáp ứng điều kiện quản lý vốn?","options":["Credit risk mitigation và có thể hỗ trợ giảm yêu cầu vốn pháp lý","Đảm bảo không còn quy định vốn","Tăng bảo đảm chất lượng hàng","Loại bỏ nhu cầu giám sát khoản vay"],"correct":0,"explanation":"Capital relief cần đáp ứng các điều kiện pháp lý, không mặc nhiên được hưởng.","source":"DB tr.63; 74","level":"Trung bình"},{"id":"TF138","category":"insurance","question":"Theo OECD Arrangement được DB nêu, các ECA tham gia có mục tiêu chính gì?","options":["Hạn chế cạnh tranh dựa ưu đãi điều kiện tín dụng quá mức, tạo sân chơi tương đối bình đẳng","Cấm hoàn toàn thương mại quốc tế","Ấn định giá bán hàng hóa","Thay thế ngân hàng thương mại"],"correct":0,"explanation":"Arrangement quy định về tenor, lãi, repayment terms và premium cho các chương trình thuộc phạm vi.","source":"DB tr.63–64","level":"Trung bình"},{"id":"TF139","category":"insurance","question":"Surety Bond có chức năng gần với công cụ nào?","options":["Bảo đảm tiền khi bên có nghĩa vụ không thực hiện theo điều kiện bảo lãnh/bảo hiểm","FX Spot","Open Account thuần túy","B/L đường biển"],"correct":0,"explanation":"Surety là công cụ bảo đảm nghĩa vụ thường do doanh nghiệp bảo hiểm phát hành.","source":"DB tr.75","level":"Trung bình"},{"id":"TF140","category":"insurance","question":"Nếu một lô hàng hỏng trên đường đi, chỉ có Payment Guarantee thì đã bảo hiểm hàng chưa?","options":["Chưa; phải xem quyền/rủi ro theo hợp đồng và Cargo Insurance","Rồi, Payment Guarantee luôn bồi thường hàng hỏng","Rồi, không cần chứng minh tổn thất","Rồi, ngân hàng phát hành vận đơn"],"correct":0,"explanation":"Payment Guarantee đảm bảo trả tiền, không thay cargo insurance.","source":"Ứng dụng; DB tr.14–15, 32–35","level":"Trung bình"},{"id":"TF141","category":"insurance","question":"Xuất khẩu thiết bị có thời gian trả nhiều năm, Buyer ở thị trường nhiều rủi ro: công cụ hỗ trợ nào đáng xem xét?","options":["ECA-supported finance / export credit insurance","Chỉ Open Account không bảo đảm","Chỉ B/L Issue Date","Chỉ Packing List"],"correct":0,"explanation":"ECA support có thể mở rộng năng lực tài trợ các giao dịch quy mô lớn, tenor dài, chịu rủi ro chính trị.","source":"DB tr.59–64","level":"Trung bình"},{"id":"TF142","category":"fx","question":"Spot FX là gì?","options":["Giao dịch mua/bán ngoại tệ theo tỷ giá giao ngay, thanh toán theo quy ước thị trường","Cam kết chắc chắn tỷ giá sau 10 năm","Bảo hiểm non-payment","Bảo lãnh dự thầu"],"correct":0,"explanation":"Spot giao dịch tỷ giá hiện tại, thường được thanh toán trong vòng hai ngày làm việc tùy cặp tiền.","source":"DB tr.80","level":"Cơ bản"},{"id":"TF143","category":"fx","question":"Forward FX giúp doanh nghiệp điều gì?","options":["Khóa tỷ giá cho việc mua/bán ngoại tệ ở một ngày tương lai","Bảo đảm Buyer không default","Bảo hiểm hư hỏng hàng hóa","Thay toàn bộ Sales Contract"],"correct":0,"explanation":"FX Forward dùng để quản trị bất định tỷ giá theo kỳ hạn xác định.","source":"DB tr.80","level":"Cơ bản"},{"id":"TF144","category":"fx","question":"Importer Việt Nam phải mua USD sau 90 ngày, lo USD tăng: nên cân nhắc gì?","options":["Buy USD Forward","Sell USD Forward mà không có USD phải thu","Chỉ Cargo Insurance","Chỉ Bid Bond"],"correct":0,"explanation":"Importer có nghĩa vụ chi USD nên mua USD kỳ hạn có thể giảm rủi ro USD tăng.","source":"Ứng dụng FX; DB tr.79–80","level":"Cơ bản"},{"id":"TF145","category":"fx","question":"Exporter Việt Nam sẽ thu USD sau 90 ngày, lo USD giảm: nên cân nhắc gì?","options":["Sell USD Forward","Buy USD Forward không có nghĩa vụ","Advance Payment Guarantee thay hedge","D/P at Sight luôn loại bỏ FX"],"correct":0,"explanation":"Exporter có USD receivable có thể bán USD kỳ hạn để khóa giá trị VND dự kiến.","source":"Ứng dụng FX; DB tr.79–80","level":"Cơ bản"},{"id":"TF146","category":"fx","question":"Trên bảng giá USD/VND, BID của ngân hàng là gì?","options":["Tỷ giá ngân hàng mua USD từ khách hàng","Tỷ giá ngân hàng bán USD cho khách hàng","Phí bảo hiểm hàng","Ngày phát hành B/L"],"correct":0,"explanation":"Đọc Bid/Ask từ góc nhìn ngân hàng; exporter bán USD được giá Bid.","source":"Ứng dụng FX; DB tr.79–80","level":"Trung bình"},{"id":"TF147","category":"fx","question":"Trên bảng giá USD/VND, ASK của ngân hàng là gì?","options":["Tỷ giá ngân hàng bán USD cho khách hàng","Tỷ giá ngân hàng mua USD từ khách hàng","Giá trị khoản vay RBL","Kỳ hạn L/C"],"correct":0,"explanation":"Importer mua USD từ bank thường nhìn giá Ask.","source":"Ứng dụng FX; DB tr.79–80","level":"Trung bình"},{"id":"TF148","category":"fx","question":"Bank báo USD/VND 25.300 / 25.340, Buyer muốn mua 10.000 USD phải tính theo giá nào?","options":["25.340 VND/USD (Ask)","25.300 VND/USD (Bid)","Trung bình luôn 25.320","Không cần dùng tỷ giá"],"correct":0,"explanation":"Khách mua USD từ bank ở giá bán (Ask), chưa tính phí khác.","source":"Ví dụ giả định; FX mở rộng","level":"Trung bình"},{"id":"TF149","category":"fx","question":"Bank báo BID 25.300 và ASK 25.340, Spread là bao nhiêu?","options":["40 VND/USD","640 VND/USD","25.300 VND/USD","10 VND/USD"],"correct":0,"explanation":"Spread = Ask − Bid = 25.340 − 25.300 = 40 VND/USD.","source":"Ví dụ giả định; FX mở rộng","level":"Trung bình"},{"id":"TF150","category":"fx","question":"FX Swap về cơ bản thường kết hợp những giao dịch nào?","options":["Mua và bán cùng cặp tiền ở hai ngày giá trị khác nhau","Hai hợp đồng bảo hiểm hàng","Hai bảo lãnh thực hiện","Hai sales contracts không liên quan"],"correct":0,"explanation":"FX swap trao đổi ngoại tệ ở hai kỳ để quản lý thanh khoản và trạng thái ngoại tệ.","source":"Mở rộng thực hành FX; DB Ch.9","level":"Trung bình"},{"id":"TF151","category":"fx","question":"Currency Option khác FX Forward ở quyền của người mua option thế nào?","options":["Người mua có quyền nhưng không buộc thực hiện option, thường phải trả premium","Người mua luôn bắt buộc giao dịch ở tỷ giá đã chốt","Không có bất kỳ chi phí nào","Option là L/C phát hành tự động"],"correct":0,"explanation":"Option tạo protection with upside linh hoạt hơn nhưng có chi phí premium.","source":"Mở rộng hedging; DB tr.15","level":"Trung bình"},{"id":"TF152","category":"fx","question":"Natural Hedge là gì?","options":["Cân đối doanh thu và chi phí cùng loại ngoại tệ để giảm exposure","Mua bảo lãnh hoàn ứng","Cho vay dựa trên tồn kho","Chuyển giao vận đơn cho bank"],"correct":0,"explanation":"Natural hedge làm giảm nhu cầu mua công cụ phái sinh nếu dòng thu chi cùng ngoại tệ.","source":"Mở rộng FX; DB Ch.9","level":"Trung bình"},{"id":"TF153","category":"fx","question":"Một FX Forward bảo vệ loại rủi ro nào trực tiếp nhất?","options":["Tỷ giá thay đổi bất lợi giữa ký hợp đồng và ngày thanh toán","Buyer phá sản","Seller giao hàng thiếu","B/L giả mạo"],"correct":0,"explanation":"Hedging FX không loại bỏ counterparty default hoặc cargo risk.","source":"DB tr.79–80","level":"Trung bình"},{"id":"TF154","category":"fx","question":"Một công ty đã không còn nghĩa vụ USD nhưng vẫn giữ vị thế Buy USD Forward lớn: nguy cơ nào?","options":["Over-hedging hoặc tạo trạng thái đầu cơ ngoài nhu cầu thực","Không có rủi ro vì là trade finance","Tự động được insurance payout","Giảm mọi rủi ro tín dụng"],"correct":0,"explanation":"Kích thước và ngày hedge cần phù hợp exposure thực tế.","source":"Mở rộng thực hành FX","level":"Nâng cao"},{"id":"TF155","category":"fx","question":"Đâu là cách đọc đúng về Forward Rate so với Spot Rate?","options":["Forward có thể khác Spot do cấu trúc lãi suất/điểm kỳ hạn, không đơn giản là dự báo tương lai","Forward luôn lớn hơn Spot","Forward luôn bằng Spot","Forward là phí bảo hiểm hàng"],"correct":0,"explanation":"Forward points chủ yếu phản ánh chênh lệch lãi suất/cơ chế thị trường và basis.","source":"Mở rộng thực hành FX; DB tr.80","level":"Nâng cao"},{"id":"TF156","category":"fx","question":"Importer cần trả 100.000 USD, bank ASK 25.340 VND/USD: tổng VND mua USD là bao nhiêu (chưa tính phí)?","options":["2.534.000.000 VND","2.530.000.000 VND","253.400.000 VND","25.340.000 VND"],"correct":0,"explanation":"100.000 × 25.340 = 2,534 tỷ VND.","source":"Ví dụ giả định; Bid/Ask","level":"Nâng cao"},{"id":"TF157","category":"cases","question":"Buyer mới, Seller lo không nhận được tiền dù đã giao hàng; sản phẩm thanh toán nào nên cân nhắc trước?","options":["Confirmed Commercial L/C (nếu phù hợp rủi ro)","Open Account không bảo đảm","D/A không bảo đảm","Chỉ xuất Invoice"],"correct":0,"explanation":"Confirmed L/C thêm undertaking của ngân hàng xác nhận nhưng vẫn cần complying presentation.","source":"Tình huống tổng hợp; DB tr.21–31","level":"Nâng cao"},{"id":"TF158","category":"cases","question":"Buyer muốn nhận hàng và trả sau 60 ngày, Seller chấp nhận rủi ro tín dụng Buyer: phương thức nào điển hình?","options":["Open Account Net 60","Advance Payment 100%","D/P at Sight","Bid Guarantee"],"correct":0,"explanation":"Open Account giao trước trả sau; seller thường cần đánh giá buyer.","source":"Tình huống tổng hợp; DB tr.22","level":"Cơ bản"},{"id":"TF159","category":"cases","question":"Seller muốn Buyer trả tiền trước khi ngân hàng giao vận đơn gốc theo chỉ thị: chọn gì?","options":["D/P at Sight","D/A 90 days","Open Account không có kiểm soát chứng từ","Financial Standby"],"correct":0,"explanation":"D/P gắn giao documents với payment.","source":"Tình huống tổng hợp; DB tr.24–25","level":"Cơ bản"},{"id":"TF160","category":"cases","question":"Buyer phải nhận chứng từ trước và trả sau bằng hối phiếu kỳ hạn, Seller chấp thuận: chọn gì?","options":["D/A","D/P at Sight","Advance Payment 100%","Bid Bond"],"correct":0,"explanation":"D/A dùng acceptance thay vì immediate payment để release documents.","source":"Tình huống tổng hợp; DB tr.24–25","level":"Cơ bản"},{"id":"TF161","category":"cases","question":"Buyer đã ứng 30% hợp đồng nhưng lo Seller không giao hàng, công cụ hỗ trợ gì?","options":["Advance Payment Guarantee","FX Spot","Forfaiting","Reserve Based Lending"],"correct":0,"explanation":"APG bảo vệ advance theo điều kiện demand và expiry.","source":"Tình huống tổng hợp; DB tr.23, 34","level":"Trung bình"},{"id":"TF162","category":"cases","question":"Nhà thầu cần chứng minh cam kết không rút hồ sơ dự thầu: chọn gì?","options":["Bid/Tender Guarantee","Factoring","Commercial Invoice","Cargo Insurance"],"correct":0,"explanation":"Bid Bond áp dụng giai đoạn tender.","source":"Tình huống tổng hợp; DB tr.34","level":"Trung bình"},{"id":"TF163","category":"cases","question":"Dự án đã hoàn tất, Buyer giữ lại 10% tiền bảo hành; Seller muốn được giải ngân toàn bộ: chọn gì?","options":["Retention Guarantee nếu Buyer chấp thuận","Red Clause L/C","FX Swap","D/A at sight"],"correct":0,"explanation":"Retention guarantee thay thế khoản giữ lại theo điều kiện hợp đồng.","source":"Tình huống tổng hợp; DB tr.35","level":"Trung bình"},{"id":"TF164","category":"cases","question":"Seller bán hàng 1 tỷ theo Net 60 và muốn nhận tiền ngay, nhờ factor thu nợ: chọn gì?","options":["Factoring","RBL","Performance Standby","Advance Payment"],"correct":0,"explanation":"Factoring biến receivables thành cash và factor thường đảm nhận collections.","source":"Tình huống tổng hợp; DB tr.51","level":"Trung bình"},{"id":"TF165","category":"cases","question":"Buyer là tập đoàn lớn muốn Supplier được thanh toán sớm sau khi duyệt invoice: chọn gì?","options":["Payables Finance / Reverse Factoring","Bid Guarantee","RBL","Commercial L/C Revocable"],"correct":0,"explanation":"Payables Finance là buyer-led programme cho supply chain.","source":"Tình huống tổng hợp; DB tr.52","level":"Trung bình"},{"id":"TF166","category":"cases","question":"Seller xuất khẩu thiết bị giá trị lớn trả nhiều kỳ trong 4 năm; muốn thu tiền ngay và tránh truy đòi thông thường: chọn gì?","options":["Forfaiting trên nghĩa vụ thanh toán đủ điều kiện","Open Account thuần túy","Loan against Inventory luôn tốt nhất","Bid Bond"],"correct":0,"explanation":"Forfaiting thường phù hợp nghĩa vụ chuyển nhượng được trong giao dịch dài hạn.","source":"Tình huống tổng hợp; DB tr.49–50","level":"Nâng cao"},{"id":"TF167","category":"cases","question":"Trader có inventory và receivables biến động, muốn hạn mức vay xoay vòng dựa tài sản đủ điều kiện: chọn gì?","options":["Borrowing Base Finance (BBF)","Financial Standby","D/P at Sight","FX Spot"],"correct":0,"explanation":"BBF tái định giá tài sản bảo đảm định kỳ, giới hạn theo eligible borrowing base.","source":"Tình huống tổng hợp; DB tr.56–57","level":"Trung bình"},{"id":"TF168","category":"cases","question":"Doanh nghiệp thăm dò và khai thác dầu khí cần tài trợ phát triển mỏ: sản phẩm nào phù hợp?","options":["Reserve-Based Lending (RBL)","Factoring hóa đơn bán lẻ","APG thuần túy","D/A không có hối phiếu"],"correct":0,"explanation":"RBL dựa cash flow/NPV của trữ lượng tài sản khai thác.","source":"Tình huống tổng hợp; DB tr.57","level":"Trung bình"},{"id":"TF169","category":"cases","question":"Ngân hàng đã tài trợ 100 triệu USD nhưng muốn bớt concentration mà không bán trực tiếp toàn bộ khoản vay: nên xem gì?","options":["Unfunded/Funded Risk Participation và Insurance","Chỉ issue B/L mới","Chỉ APG cho Seller","Chỉ mở tài khoản VND"],"correct":0,"explanation":"Participation và insurance cho phép chia exposure theo hợp đồng.","source":"Tình huống tổng hợp; DB tr.71–75","level":"Nâng cao"},{"id":"TF170","category":"cases","question":"Buyer cần mua USD trong ba tháng và sợ USD lên giá, công cụ hedging nào tương ứng?","options":["Buy USD Forward","Sell USD Forward","Cargo Insurance","Bid Bond"],"correct":0,"explanation":"Lock tỷ giá mua USD tương lai để giảm FX uncertainty.","source":"Tình huống tổng hợp; DB tr.79–80","level":"Trung bình"},{"id":"TF171","category":"cases","question":"Hàng được giao theo điều kiện mà Buyer chịu rủi ro tổn thất trên biển; Buyer nên kiểm tra thêm công cụ nào?","options":["Cargo Insurance phù hợp với hợp đồng và Incoterms","Payment Guarantee luôn đủ","Factoring sẽ bảo hiểm hàng hỏng","Forward Rate sẽ ngăn tai nạn"],"correct":0,"explanation":"Bảo hiểm vật chất hàng khác bảo hiểm không thanh toán.","source":"Tình huống tổng hợp; DB tr.14–15; 74","level":"Trung bình"},{"id":"TF172","category":"cases","question":"Buyer và Seller cùng Bank X, mở L/C nội địa: điểm nào vẫn bắt buộc quản trị?","options":["Hạn mức/khả năng trả tiền, chứng từ, KYC, phân quyền và tuân thủ","Không cần bất cứ kiểm soát nào","Tự động bỏ Sales Contract","Không cần xác định beneficiary"],"correct":0,"explanation":"Chung một bank chỉ giảm một số công đoạn, không làm mất nghĩa vụ/rủi ro.","source":"Mở rộng nghiệp vụ Việt Nam","level":"Trung bình"},{"id":"TF173","category":"cases","question":"Seller nhận tiền ứng trước 30%, thiếu thêm vốn sản xuất và có hợp đồng chắc chắn: có thể kết hợp gì?","options":["Advance Payment + APG cho Buyer và Pre-shipment Loan theo thẩm định","Chỉ C/O, không cần dòng tiền","Chỉ B/L Issue Date","Chỉ bảo hiểm cargo"],"correct":0,"explanation":"Một giao dịch có thể ghép funding và guarantee để xử lý nhu cầu khác nhau.","source":"Tình huống tổng hợp; DB tr.23, 34, 53","level":"Trung bình"},{"id":"TF174","category":"cases","question":"Bộ chứng từ L/C có discrepancy, Seller nên làm gì?","options":["Xác định lỗi, cân nhắc sửa/khắc phục hoặc xin waiver theo quy trình; không tự giả định ngân hàng trả","Giả mạo vận đơn để khớp","Yêu cầu ngân hàng bỏ qua mọi lỗi","Tự ý sửa chữ trên chứng từ bên thứ ba"],"correct":0,"explanation":"Discrepancy có thể dẫn đến từ chối thanh toán; việc xử lý phụ thuộc credit, rules và waiver.","source":"Ứng dụng; DB tr.26–31","level":"Trung bình"},{"id":"TF175","category":"rules","question":"UCP 600 thường được áp dụng cho nghiệp vụ nào?","options":["Documentary Credits / Commercial L/C nếu dẫn chiếu","Chỉ FX Spot","Chỉ Cargo Insurance","Chỉ RBL"],"correct":0,"explanation":"UCP 600 là ICC rules dành cho documentary credits.","source":"DB tr.40–41","level":"Cơ bản"},{"id":"TF176","category":"rules","question":"ISBP 821 dùng để hỗ trợ việc gì?","options":["Thực hành chuẩn trong kiểm tra chứng từ theo UCP 600","Định giá dầu khí","Xác định tiền lương nhân viên","Hướng dẫn thuế VAT nội địa"],"correct":0,"explanation":"ISBP hướng dẫn kiểm tra chứng từ và bổ trợ UCP 600.","source":"DB tr.40–41","level":"Cơ bản"},{"id":"TF177","category":"rules","question":"URC 522 liên quan nghiệp vụ nào?","options":["Documentary Collections như D/P, D/A khi dẫn chiếu","FX Swap","RBL","Cargo Insurance"],"correct":0,"explanation":"URC 522 quy định thực hành và trách nhiệm các bên trong nhờ thu.","source":"DB tr.42","level":"Cơ bản"},{"id":"TF178","category":"rules","question":"URDG 758 thường áp dụng cho công cụ nào khi bảo lãnh dẫn chiếu?","options":["Demand Guarantee","Spot FX","Factoring invoice","Reserve-Based Lending"],"correct":0,"explanation":"URDG 758 là Uniform Rules for Demand Guarantees.","source":"DB tr.42","level":"Cơ bản"},{"id":"TF179","category":"rules","question":"ISP98 thường áp dụng cho nghiệp vụ nào?","options":["Standby L/C","D/P at Sight bắt buộc","Warehouse Finance","Bid/Ask Quote"],"correct":0,"explanation":"ISP98 thiết kế phù hợp đặc thù Standby Credits.","source":"DB tr.37; 42","level":"Trung bình"},{"id":"TF180","category":"rules","question":"URF 800 là bộ quy tắc cho sản phẩm nào?","options":["Forfaiting","Commercial Invoice","B/L điện tử","Forward FX"],"correct":0,"explanation":"URF 800 là Uniform Rules for Forfaiting.","source":"DB tr.43","level":"Trung bình"},{"id":"TF181","category":"rules","question":"URR 725 đề cập vấn đề gì?","options":["Reimbursement giữa các ngân hàng dưới Documentary Credit","Bảo hiểm hàng","Quản lý doanh nghiệp khai thác dầu","Thanh toán qua thẻ"],"correct":0,"explanation":"URR 725 là rules cho bank-to-bank reimbursement under documentary credits.","source":"DB tr.40–41","level":"Trung bình"},{"id":"TF182","category":"rules","question":"eUCP có mục tiêu gì?","options":["Bổ sung quy tắc cho xuất trình điện tử trong documentary credits","Thay thế mọi hợp đồng mua bán","Kiểm soát giá dầu","Tự động phát hành passport"],"correct":0,"explanation":"eUCP hỗ trợ electronic presentation khi L/C được cấu trúc phù hợp.","source":"DB tr.40–41; 90–92","level":"Trung bình"},{"id":"TF183","category":"rules","question":"URDTT được thiết kế cho điều gì?","options":["Các giao dịch thương mại số dựa vào electronic records/data","Chỉ thẻ tín dụng cá nhân","Chỉ vận tải đường bộ","Chỉ bảo hiểm y tế"],"correct":0,"explanation":"URDTT là Uniform Rules for Digital Trade Transactions.","source":"DB tr.43; 90–92","level":"Trung bình"},{"id":"TF184","category":"rules","question":"MLETR có ý nghĩa gì?","options":["Model Law hỗ trợ công nhận electronic transferable records tương đương chức năng giấy","Bắt buộc cấm vận đơn điện tử","Là bộ quy tắc FX Options","Là bảo hiểm hàng"],"correct":0,"explanation":"MLETR hỗ trợ nền tảng pháp lý cho eBL và chứng từ chuyển nhượng điện tử.","source":"DB tr.88–89","level":"Trung bình"},{"id":"TF185","category":"rules","question":"Bản đồ MLETR trong tài liệu Deutsche Bank phản ánh tình trạng đến thời điểm nào?","options":["Tháng 9/2025","Ngày 20/11/2026","Tháng 1/2020","Năm 2035"],"correct":0,"explanation":"Figure 15 lưu ý thông tin đúng đến September 2025; không dùng như cập nhật pháp luật hiện tại.","source":"DB tr.89","level":"Trung bình"},{"id":"TF186","category":"rules","question":"TBML là viết tắt của gì?","options":["Trade-Based Money Laundering","Trade Bill Market Lending","Tax Backed Market Liquidity","Tender-Based Loan"],"correct":0,"explanation":"TBML lợi dụng luồng thương mại để hợp thức hóa chuyển giá trị bất hợp pháp.","source":"DB tr.93–94","level":"Trung bình"},{"id":"TF187","category":"rules","question":"Dấu hiệu nào có thể liên quan Trade-Based Money Laundering?","options":["Khai sai giá trị, số lượng hoặc chất lượng hàng hóa nhằm chuyển giá trị","Buyer và Seller ký sales contract minh bạch","C/O đúng quy định","Thanh toán đúng invoice đã thẩm định"],"correct":0,"explanation":"Over-/under-invoicing và misdescription là red flags cần kiểm tra.","source":"DB tr.93–98","level":"Trung bình"},{"id":"TF188","category":"rules","question":"Screening sanctions trong Trade Finance nhằm làm gì?","options":["Kiểm tra đối tác, giao dịch và hoạt động bị hạn chế/cấm theo quy định áp dụng","Đảm bảo tỷ giá không đổi","Dự báo sức chứa cảng","Mua quyền chọn"],"correct":0,"explanation":"Ngân hàng phải đáp ứng sanctions controls theo phạm vi pháp lý liên quan.","source":"DB tr.96","level":"Trung bình"},{"id":"TF189","category":"rules","question":"Dual-use Goods nghĩa là gì?","options":["Hàng hóa/công nghệ có thể dùng cho cả dân sự và quân sự","Hàng chỉ dùng được một lần","Hàng không có xuất xứ","Hàng đã bảo hiểm hai lần"],"correct":0,"explanation":"Dual-use goods cần đánh giá export control và end-use/end-user.","source":"DB tr.95","level":"Trung bình"},{"id":"TF190","category":"rules","question":"Tại sao một bộ B/L có vẻ hợp lệ vẫn có thể tồn tại Fraud Risk?","options":["Ngân hàng xem chứng từ, hàng có thể không tồn tại hoặc chứng từ bị giả","Vì mọi B/L đều sai","Vì Buyer không cần vận chuyển","Vì B/L chính là bảo hiểm"],"correct":0,"explanation":"Trade document fraud và double financing đòi hỏi xác minh và kiểm soát.","source":"DB tr.96–98","level":"Trung bình"},{"id":"TF191","category":"rules","question":"“Digitisation” và “Digitalisation” trong tài liệu DB được thảo luận với mục tiêu nào?","options":["Tái thiết quy trình và đưa chứng từ/quy trình thương mại lên môi trường số","Cấm hoàn toàn bản giấy kể từ 2025","Bảo đảm mọi quốc gia đã chấp nhận eBL","Tăng bắt buộc số lượng ngân hàng"],"correct":0,"explanation":"DB phân biệt hai hướng chuyển đổi số và rào cản luật/chứng từ.","source":"DB tr.86–90","level":"Trung bình"},{"id":"TF192","category":"rules","question":"UCP 600 có bắt buộc áp dụng cho mọi giao dịch Trade Finance không?","options":["Không; cần xác định loại sản phẩm và điều khoản dẫn chiếu của cam kết","Có, kể cả hợp đồng FX Swap","Có, mọi bảo hiểm hàng","Có, mọi D/P đều là L/C"],"correct":0,"explanation":"Các bộ rule ICC được sử dụng theo loại nghiệp vụ và điều khoản áp dụng.","source":"DB tr.40–43","level":"Trung bình"},{"id":"TF193","category":"rules","question":"Nếu seller nhận được L/C nhưng yêu cầu xuất trình chứng từ mâu thuẫn/không rõ, nên làm gì?","options":["Đề nghị làm rõ hoặc sửa L/C trước khi giao hàng nếu cần","Bỏ qua mâu thuẫn và giao hàng ngay","Làm giả chứng từ sau giao","Đổi B/L mà không hỏi hãng tàu"],"correct":0,"explanation":"Wording rõ ràng giúp giảm documentary discrepancies và execution risk.","source":"DB tr.31","level":"Trung bình"},{"id":"TF194","category":"decision","question":"Ưu điểm của Open Account đối với Buyer là gì?","options":["Có thể nhận hàng trước và trả tiền sau, cải thiện cash flow","Được ngân hàng luôn bảo lãnh tiền hàng","Không chịu bất cứ rủi ro hàng hóa nào","Không cần sales contract"],"correct":0,"explanation":"Buyer hưởng khoản thương mại trả chậm; seller chịu credit risk.","source":"DB tr.21–22","level":"Cơ bản"},{"id":"TF195","category":"decision","question":"Điểm yếu lớn nhất của D/P so với Commercial L/C là gì?","options":["Không có cam kết thanh toán ngân hàng; Buyer có thể từ chối trả và nhận chứng từ","D/P không bao giờ có B/L","D/P luôn có phí cao hơn mọi L/C","D/P bắt Buyer trả sau 10 năm"],"correct":0,"explanation":"D/P là document control, không phải bank payment undertaking.","source":"DB tr.24–26","level":"Cơ bản"},{"id":"TF196","category":"decision","question":"Công cụ nào giúp Seller vừa có chắc chắn hơn về bank risk và có thể thu tiền trước maturity?","options":["Confirmed Usance L/C kết hợp discounting/forfaiting nếu đủ điều kiện","Open Account đơn thuần","D/A không chấp nhận tài trợ","Chỉ Cargo Insurance"],"correct":0,"explanation":"Kết hợp undertaking và receivables financing cần xét ngân hàng, chứng từ và recourse.","source":"Tổng hợp DB tr.27, 49–50","level":"Cơ bản"},{"id":"TF197","category":"decision","question":"Tại sao một Seller có thể ưu tiên Factoring thay vì Loan Against Receivables?","options":["Có thể đi kèm dịch vụ quản lý/thu hồi công nợ và chuyển nhượng receivables","Factoring luôn không tốn phí","Factoring không cần invoices","Factoring là bảo lãnh dự thầu"],"correct":0,"explanation":"Factoring được DB phân biệt bởi debt collection/control.","source":"DB tr.51–52","level":"Cơ bản"},{"id":"TF198","category":"decision","question":"Khi nào không nên xem L/C là giải pháp duy nhất?","options":["Khi rủi ro chính là hư hỏng hàng, gian lận thực tế hoặc thiếu vốn trước sản xuất","Khi Seller xuất trình chứng từ","Khi Buyer và Seller ký hợp đồng","Khi giao dịch có ngân hàng"],"correct":0,"explanation":"L/C chủ yếu bảo đảm payment against compliant docs, cần thêm cargo insurance/pre-shipment finance khi phù hợp.","source":"DB tr.28; 53; 74","level":"Trung bình"},{"id":"TF199","category":"decision","question":"Ưu điểm chính của Payables Finance dành cho Supplier?","options":["Thu tiền sớm, thường theo tín nhiệm Buyer trong buyer-led programme","Không phải giao hàng","Được mua ngoại tệ miễn phí","Không cần có khoản phải thu hợp lệ"],"correct":0,"explanation":"Payables finance tăng thanh khoản trong supplier chain.","source":"DB tr.52","level":"Trung bình"},{"id":"TF200","category":"decision","question":"Hạn chế lớn của BBF theo góc nhìn ngân hàng?","options":["Phải kiểm soát collateral, định giá borrowing base liên tục và xử lý shortfall","Không cần báo cáo","Không có borrower credit risk","Không cần security"],"correct":0,"explanation":"Asset-based facility đòi hỏi monitoring và eligibility controls.","source":"DB tr.56–57","level":"Trung bình"},{"id":"TF201","category":"decision","question":"Thế mạnh của SBLC/Payment Guarantee khi bán Open Account cho Buyer mới là gì?","options":["Tạo kênh claim dưới cam kết ngân hàng nếu Buyer không trả theo điều kiện","Loại bỏ nhu cầu kiểm tra mọi chứng từ","Thay thế kiểm tra hàng hóa","Tự động khóa tỷ giá"],"correct":0,"explanation":"Cam kết ngân hàng là một layer giảm risk, không xóa mọi residual risk.","source":"DB tr.32–39","level":"Trung bình"},{"id":"TF202","category":"decision","question":"Nhược điểm thường gặp của L/C so với Open Account là gì?","options":["Chi phí, yêu cầu chứng từ và discrepancy risk lớn hơn","Không có ngân hàng tham gia","Seller không được giao hàng","Không có điều khoản kỳ hạn"],"correct":0,"explanation":"L/C tăng mức bảo đảm nhưng cần vận hành documentary compliance.","source":"DB tr.21; 26–31","level":"Trung bình"},{"id":"TF203","category":"decision","question":"Một Seller lo cùng lúc Buyer default và USD giảm giá: kết hợp nào xử lý hai rủi ro khác nhau?","options":["Credit Insurance/SBLC và Sell USD Forward nếu phù hợp","Chỉ Cargo Insurance","Chỉ Bid Bond","Chỉ C/O"],"correct":0,"explanation":"Bảo vệ credit và hedge FX giải quyết hai loại risk riêng.","source":"Tổng hợp DB tr.14–15, 74, 79–80","level":"Trung bình"},{"id":"TF204","category":"decision","question":"“Best product” trong Trade Finance nên được chọn bằng câu hỏi nào trước?","options":["Ai cần tiền lúc nào, nghĩa vụ nào cần bảo đảm, và residual risk là gì?","Sản phẩm nào có tên dài nhất","Ngân hàng nào có brochure đẹp nhất","Sản phẩm nào luôn có phí cao nhất"],"correct":0,"explanation":"Chọn theo cash-flow timeline, risk allocation và contract requirements.","source":"Tổng hợp tài liệu","level":"Trung bình"},{"id":"TF205","category":"decision","question":"Một hợp đồng mua máy móc lặp lại hàng tháng với supplier cũ: L/C nào có thể giảm thao tác mở mới?","options":["Revolving L/C","Counter Standby","Revocable L/C","Warranty Guarantee"],"correct":0,"explanation":"Revolving credit tự tái lập availability theo điều khoản.","source":"DB tr.29","level":"Trung bình"},{"id":"TF206","category":"decision","question":"Trung gian thương mại muốn dùng một L/C chuyển phần quyền thụ hưởng cho supplier: chọn gì nếu điều kiện được đáp ứng?","options":["Transferable L/C","RBL","Payment Guarantee","FX Swap"],"correct":0,"explanation":"Transferable credit phải thể hiện được phép chuyển và ngân hàng đồng ý thực hiện.","source":"DB tr.29","level":"Trung bình"},{"id":"TF207","category":"decision","question":"Trong Back-to-back L/C, vì sao rủi ro ngân hàng có thể tăng so với Transferable L/C?","options":["Vì tồn tại hai L/C riêng với cam kết và chênh lệch điều kiện/chứng từ cần kiểm soát","Vì không có hối phiếu","Vì không cần kiểm tra KYC","Vì Buyer không phải trả tiền bao giờ"],"correct":0,"explanation":"Middleman và issuing banks phải quản lý hai undertaking độc lập.","source":"DB tr.29","level":"Trung bình"},{"id":"TF208","category":"decision","question":"Bảng SWOT sản phẩm Trade Finance có ý nghĩa đúng nhất là gì?","options":["Khung so sánh Strength–Weakness–Opportunity–Threat theo bối cảnh, không thay thẩm định","Danh mục bắt buộc do Deutsche Bank xếp hạng","Quy tắc pháp luật thay cho hợp đồng","Cam kết sinh lợi cố định"],"correct":0,"explanation":"SWOT trong bản học là phân tích tổng hợp, không phải rule ICC.","source":"Bản tóm tắt mở rộng, Ch.12","level":"Trung bình"},{"id":"TF209","category":"decision","question":"Nếu một công cụ cải thiện dòng tiền Seller nhưng không chuyển credit risk, điều gì cần làm tiếp?","options":["Xem thêm bảo hiểm/guarantee và recourse của hợp đồng tài trợ","Giả định rủi ro đã hết","Không cần theo dõi Buyer","Xóa hợp đồng mua bán"],"correct":0,"explanation":"Liquidity improvement và credit risk transfer là hai mục tiêu cần tách biệt.","source":"Tổng hợp DB Ch.3; 8","level":"Trung bình"},{"id":"TF210","category":"decision","question":"Seller cần sản xuất hàng đặt riêng, Buyer muốn kiểm soát việc dùng tiền ứng trước: giải pháp nào hợp lý?","options":["Milestone Advance + APG và điều khoản kiểm soát tiến độ/giải ngân phù hợp","Open Account không kiểm soát","D/A đã nhận hàng","Chỉ Forward USD"],"correct":0,"explanation":"Có thể thiết kế ứng tiền theo milestone và protection cho Buyer, tùy hợp đồng.","source":"Tình huống mở rộng; DB tr.23, 34","level":"Trung bình"},{"id":"TF211","category":"decision","question":"Hợp đồng Incoterms quy định Buyer gánh rủi ro trên biển: một L/C chắc chắn trả tiền có khiến Buyer hết rủi ro hàng hỏng?","options":["Không; Buyer cần quản lý cargo risk và bảo hiểm độc lập","Có, L/C bảo hiểm hàng","Có, vì ngân hàng đã xem Invoice","Có, vì Seller là beneficiary"],"correct":0,"explanation":"Risk of goods và risk of payment độc lập, xử lý bằng công cụ phù hợp.","source":"DB tr.14–15, 28; diễn giải","level":"Nâng cao"},{"id":"TF212","category":"decision","question":"Vì sao với Buyer yếu tín nhiệm, Payables Finance có thể kém thuận lợi?","options":["Giá tài trợ và appetite phụ thuộc credit risk của Buyer, cần thẩm định","Vì Seller không có invoice","Vì D/P luôn bị cấm","Vì chỉ công ty dầu khí tham gia"],"correct":0,"explanation":"Buyer-led financing thường dựa vào tín nhiệm doanh nghiệp mua.","source":"DB tr.52","level":"Nâng cao"},{"id":"TF213","category":"decision","question":"Nguyên tắc tốt nhất khi phối hợp nhiều sản phẩm trong một giao dịch là gì?","options":["Tách rõ funding, payment undertaking, insurance và FX hedge để tránh khoảng trống/đúp rủi ro","Coi mọi công cụ là bảo lãnh chung","Cho rằng không cần xem hạn mức","Bỏ qua expiry, exclusions và maturity"],"correct":0,"explanation":"Giao dịch phức hợp cần mapping risk, cash và trigger chính xác.","source":"Tổng hợp DB Ch.2–9","level":"Nâng cao"}]};
