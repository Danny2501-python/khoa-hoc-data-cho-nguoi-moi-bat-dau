            "summarizeBy": "none"
          },
          {
            "name": "Số lượng",
            "dataType": "int64",
            "sourceColumn": "Số lượng",
            "isHidden": true,
            "summarizeBy": "sum"
          }
        ],
        "measures": [
          {
            "name": "Khách hàng CIF",
            "expression": "SUM('Khách hàng'[Số lượng])",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "Khách hàng",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Rows = Json.Document(\"[[\"\"Tổng\"\", 1000]]\"), T = #table({\"Nhãn\",\"Số lượng\"}, Rows), Typed = Table.TransformColumnTypes(T, {{\"Nhãn\", type text}, {\"Số lượng\", Int64.Type}}) in Typed"
